local function getAimbotTarget()
    local closest, closestDist = nil, math.huge
    local sc = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and not (AIM.teamCheck and isTeammate(plr)) then
            local char = plr.Character
            local part = char and (char:FindFirstChild(AIM.targetPart) or char:FindFirstChild("Head"))
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if part and hrp and hum and hum.Health > 0 then
                if not AIM.visibleOnly or isVisibleToCamera(plr, hrp) then
                    local pos, onS = camera:WorldToViewportPoint(part.Position)
                    if onS and pos.Z > 0 then
                        local d = (Vector2.new(pos.X, pos.Y) - sc).Magnitude
                        if d <= AIM.fov and d < closestDist then
                            closestDist = d
                            closest = part
                        end
                    end
                end
            end
        end
    end
    return closest
end
