espFolder.Name = "AuraModsESP"
espFolder.Parent = workspace

local function isVisibleToCamera(plr, hrp)
    if not hrp then return false end
    local origin = camera.CFrame.Position
    local dir = hrp.Position - origin
    local filter = {camera, espFolder}
    if plr.Character then table.insert(filter, plr.Character) end
    if player.Character then table.insert(filter, player.Character) end
    local params = makeRaycastParams(filter)
    return workspace:Raycast(origin, dir, params) == nil
end

local function newEsp()
    local cache = {}
    local h = Instance.new("Highlight")
    h.Name = "AM_HL"
