-- ==================== HELPERS ====================
local function make(class, props)
    local o = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r), Parent = o }) end
local function stroke(o, c, t) return make("UIStroke", { Color = c, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o }) end
local function fire(cb, ...)
    if type(cb) ~= "function" then return end
    task.spawn(function(...)
        local ok, err = pcall(cb, ...)
        if not ok then warn("[AuraMods] Callback: " .. tostring(err)) end
    end, ...)
end
local function setFlag(f, v) if f then Library.Flags[f] = v end end
local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end

local function buildIcon(parent, def, size, color)
    local root = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, ZIndex = 3, Parent = parent })
    local parts = {}
    local t = def.stroke or STROKE
    local function node(cx, cy, w, h, rot)
        local f = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(cx / VB, cy / VB), Size = UDim2.fromScale(w / VB, h / VB), Rotation = rot or 0, BackgroundColor3 = color, BorderSizePixel = 0, Parent = root })
        make("UICorner", { CornerRadius = UDim.new(.5, 0), Parent = f })
        parts[#parts + 1] = f
    end
    for _, line in ipairs(def.lines or {}) do
        for i = 1, #line - 1 do
            local a, b = line[i], line[i + 1]
            local dx, dy = b[1] - a[1], b[2] - a[2]
            local len = math.sqrt(dx * dx + dy * dy)
            node((a[1] + b[1]) / 2, (a[2] + b[2]) / 2, len + t, t, math.deg(math.atan2(dy, dx)))
        end
    end
    for _, d in ipairs(def.dots or {}) do node(d[1], d[2], d[3] * 2, d[3] * 2, 0) end
    return { Root = root, Parts = parts }
end
local function setIconColor(icon, color, instant)
    for _, p in ipairs(icon.Parts) do
        if instant then p.BackgroundColor3 = color
        else TweenService:Create(p, TweenInfo.new(.3, Enum.EasingStyle.Quint), { BackgroundColor3 = color }):Play() end
    end
end

