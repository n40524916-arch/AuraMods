        local box = make("TextBox", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.fromOffset(width, 30), BackgroundColor3 = THEME.BgTertiary, BorderSizePixel = 0, Text = "", PlaceholderText = o.Placeholder or "", PlaceholderColor3 = THEME.Muted, TextColor3 = THEME.Fg, Font = FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ClearTextOnFocus = false, Parent = row })
        round(box, 8)
        make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = box })
        local boxStroke = stroke(box, THEME.Line, 1)

        local value
        if numeric then value = tonumber(o.Default) or 0 else value = tostring(o.Default or "") end
        if o.Default ~= nil then box.Text = tostring(value) end
        local api = {}
        local function commit(enter, silent)
            local v = box.Text
            if numeric then
                v = tonumber(box.Text)
                if v == nil then box.Text = o.Default ~= nil and tostring(value) or "" return end
                if o.Min then v = math.max(v, o.Min) end
                if o.Max then v = math.min(v, o.Max) end
                box.Text = tostring(v)
            end
            local changed = v ~= value
            value = v
            setFlag(o.Flag, value)
            if (changed or enter) and not silent then fire(o.Callback, value) end
        end
        box:GetPropertyChangedSignal("Text"):Connect(function()
            local t = box.Text
            if numeric then
                local f = t:gsub("[^%d%.%-]", "")
                if f ~= t then box.Text = f return end
            end
            if o.MaxLength and (utf8.len(t) or #t) > o.MaxLength then
                local cut = (utf8.offset(t, o.MaxLength + 1) or (#t + 1)) - 1
                box.Text = t:sub(1, cut)
                return
            end
        end)
        box.Focused:Connect(function()
            TweenService:Create(boxStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Color = THEME.Accent, Thickness = 1.5 }):Play()
            TweenService:Create(box, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { BackgroundColor3 = THEME.BgSecondary }):Play()
        end)
        box.FocusLost:Connect(function(enter)
            TweenService:Create(boxStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Color = THEME.Line, Thickness = 1 }):Play()
            TweenService:Create(box, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { BackgroundColor3 = THEME.BgTertiary }):Play()
            commit(enter, false)
        end)
        function api:Set(v, silent) box.Text = tostring(v) commit(false, silent) end
        function api:Get() return value end
        function api:Focus() box:CaptureFocus() end
        setFlag(o.Flag, value)
        return finish(row, api)
    end

    function Tab:AddSlider(o)
        o = o or {}
        local tab = self
        local min, max = o.Min or 0, o.Max or 100
        if max < min then min, max = max, min end
        local step = o.Step or 1
        if step <= 0 then step = 1 end
        local suffix = o.Suffix or ""
        local row = newRow(tab, 58)
        rowLabel(row, o.Name or "Slider", 100, 34)
        local valueLabel = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 4), Size = UDim2.fromOffset(90, 26), BackgroundTransparency = 1, Text = "", Font = FONT_BOLD, TextSize = 12, TextColor3 = THEME.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })

        -- Modern slider track
        local track = make("Frame", { Position = UDim2.new(0, 14, 0, 42), Size = UDim2.new(1, -28, 0, 4), BackgroundColor3 = THEME.Off, BorderSizePixel = 0, Parent = row })
        round(track, 2)
        local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Parent = track })
        round(fill, 2)
        local knob = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, ZIndex = 2, Parent = track })
        round(knob, 8)
        local knobRing = make("Frame", { AnchorPoint = Vector2.new(.5,.5), Position = UDim2.fromScale(.5,.5), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = THEME.Accent, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = 1, Parent = knob })
        round(knobRing, 12)

        local hit = make("TextButton", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = row })

        local function snap(v)
            v = math.clamp(tonumber(v) or min, min, max)
            return math.clamp(min + math.floor((v - min) / step + .5) * step, min, max)
        end
        local value = snap(o.Default ~= nil and o.Default or min)
        local dragging = false

        local function render(a)
            local p = (max == min) and 0 or (value - min) / (max - min)
            local decimals = step < 1 and string.len(tostring(step)) - 2 or 0
            valueLabel.Text = string.format("%." .. decimals .. "f", value) .. suffix
            local fs, kp = UDim2.new(p, 0, 1, 0), UDim2.new(p, 0, .5, 0)
            if a then
                TweenService:Create(fill, TweenInfo.new(0.2, Enum.EasingStyle.Quint), { Size = fs }):Play()
                TweenService:Create(knob, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = kp }):Play()
            else
                fill.Size, knob.Position = fs, kp
            end
        end
        local function setValue(v, silent)
            v = snap(v)
            if v == value then return end
            value = v
            render(true)
            setFlag(o.Flag, value)
            if not silent then fire(o.Callback, value) end
        end

        hit.InputBegan:Connect(function(input)
            if not isPress(input) then return end
            tab.Page.ScrollingEnabled = false
            dragging = true
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(20, 20) }):Play()
            TweenService:Create(knobRing, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(32, 32), BackgroundTransparency = 0.85 }):Play()
            beginDrag(input, function(i)
                local p = guiPoint(i)
                local a = math.clamp((p.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                setValue(min + a * (max - min), false)
            end, function()
                dragging = false
                tab.Page.ScrollingEnabled = true
                TweenService:Create(knob, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(16, 16) }):Play()
                TweenService:Create(knobRing, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 0.7 }):Play()
            end, true)
        end)
        local api = {}
        function api:Set(v, silent) setValue(v, silent) end
        function api:Get() return value end
        render(false)
        setFlag(o.Flag, value)
        return finish(row, api)
    end

    function Tab:AddDropdown(o)
        o = o or {}
        local H = 46
        local multi = o.Multi == true
        local maxVisible = o.MaxVisible or 5
        local width = o.Width or 140
        local row = newRow(self, H)
        row.ClipsDescendants = true
        rowLabel(row, o.Name or TXT.Select, width + 24, H)

        local pill = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 9), Size = UDim2.fromOffset(width, 28), BackgroundColor3 = THEME.BgTertiary, BorderSizePixel = 0, Parent = row })
        round(pill, 8)
        local valueLabel = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -34, 1, 0), Text = "", Font = FONT_BOLD, TextSize = 12, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = pill })
        local chev = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(1, -14, .5, 0), Size = UDim2.fromOffset(12, 12), Rotation = 90, BackgroundTransparency = 1, Parent = pill })
        buildIcon(chev, ICONS.chevron, 12, THEME.Muted)

        local list = make("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(14, H + 2), Size = UDim2.new(1, -28, 0, 0), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollBarImageColor3 = THEME.Accent, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = row })
        make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3), Parent = list })
        local hit = make("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, H), ZIndex = 5, Parent = row })

        local options, buttons, sel = {}, {}, {}
        local open = false

        local function parse(items)
            local out = {}
            for _, item in ipairs(items or {}) do
                if type(item) == "table" then
                    local label = item.Label or item.Name or item.Value
                    local val = item.Value
                    if val == nil then val = label end
                    out[#out + 1] = { Label = tostring(label), Value = val }
                else
                    out[#out + 1] = { Label = tostring(item), Value = item }
                end
            end
            return out
        end
        local function getValue()
            if multi then
                local out = {}
                for _, opt in ipairs(options) do if sel[opt.Value] then out[#out + 1] = opt.Value end end
                return out
            end
            for _, opt in ipairs(options) do if sel[opt.Value] then return opt.Value end end
            return nil
        end
        local function refreshVisual()
            local labels = {}
            for i, opt in ipairs(options) do
                local on = sel[opt.Value] == true
                local b = buttons[i]
                if b then
                    b.Check.Visible = on
                    TweenService:Create(b.Label, TweenInfo.new(0.2), { TextColor3 = on and THEME.Fg or THEME.Muted }):Play()
                end
                if on then labels[#labels + 1] = opt.Label end
            end
            if #labels == 0 then
                valueLabel.Text = o.Placeholder or TXT.Select
                valueLabel.TextColor3 = THEME.Muted
            else
                valueLabel.Text = table.concat(labels, ", ")
                valueLabel.TextColor3 = THEME.Fg
            end
        end
        local function changed(silent)
            local v = getValue()
            setFlag(o.Flag, v)
            refreshVisual()
            if not silent then fire(o.Callback, v) end
        end
        local function listHeight() return #options * 32 end
        local openToken = 0
        local function setOpen(v)
            open = v
            openToken = openToken + 1
            local mine = openToken
            list.Size = UDim2.new(1, -28, 0, math.min(listHeight(), maxVisible * 32))
            list.Visible = true
            local tw = TweenService:Create(row, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, H + (v and (math.min(listHeight(), maxVisible * 32) + 8) or 0)) })
            tw:Play()
            TweenService:Create(chev, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = v and -90 or 90 }):Play()
            if not v then
                tw.Completed:Once(function() if openToken == mine then list.Visible = false end end)
            end
        end
        local function pick(value)
            if multi then sel[value] = (not sel[value]) or nil
            else sel = { [value] = true } end
            changed(false)
            if not multi then setOpen(false) end
        end

        local function build()
            for _, b in ipairs(buttons) do b.Button:Destroy() end
            buttons = {}
            for i, opt in ipairs(options) do
                local btn = make("TextButton", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = THEME.BgTertiary, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, Text = "", Parent = list })
                round(btn, 6)
                local lbl = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -34, 1, 0), Text = opt.Label, Font = FONT_BOLD, TextSize = 12, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn })
                local check = make("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Visible = false, Parent = btn })
                buildIcon(check, ICONS.check, 12, THEME.Accent)

                btn.MouseEnter:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
                end)
                btn.MouseLeave:Connect(function()
                    TweenService:Create(btn, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
                end)
                btn.Activated:Connect(function() pick(opt.Value) end)
                buttons[i] = { Button = btn, Label = lbl, Check = check }
            end
        end

        options = parse(o.Options)
        if multi then
            local d = o.Default
            if type(d) == "table" then for _, x in ipairs(d) do sel[x] = true end
            elseif d ~= nil then sel[d] = true end
        elseif o.Default ~= nil then sel[o.Default] = true end
        build()
        changed(true)
        hit.Activated:Connect(function() setOpen(not open) end)

        local api = {}
        function api:Get() return getValue() end
        function api:Set(v, silent)
            sel = {}
            if multi then
                local arr = type(v) == "table" and v or { v }
                for _, x in ipairs(arr) do sel[x] = true end
            elseif v ~= nil then sel[v] = true end
            changed(silent)
        end
        function api:Refresh(items)
            options = parse(items)
            local valid = {}
            for _, opt in ipairs(options) do if sel[opt.Value] then valid[opt.Value] = true end end
            sel = valid
            build()
            changed(true)
        end
        return finish(row, api)
    end

    -- ============================================================
    -- TAB REGISTER
    -- ============================================================
    function Window:AddTab(t)
        t = t or {}
        local i = #tabs + 1
        local name = t.Name or ("Tab " .. i)
        local def = ICONS[t.Icon or "spark"] or ICONS.spark
        slots = slots + 1
        local slot = slots

        local btn = make("TextButton", { Name = name, Position = UDim2.fromOffset(6, (slot - 1) * SLOT), Size = UDim2.fromOffset(44, 44), BackgroundTransparency = 1, AutoButtonColor = false, Text = "", ZIndex = 2, Parent = Sidebar })
        local icon = buildIcon(btn, def, 22, THEME.Muted)

        -- Hover efekti
        btn.MouseEnter:Connect(function()
            if current ~= i then
                TweenService:Create(icon.Root, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Size = UDim2.fromOffset(26, 26) }):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(icon.Root, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Size = UDim2.fromOffset(22, 22) }):Play()
        end)

        local tab = setmetatable({ Name = name, Slot = slot, Sub = t.Sub or "", Page = newPageFrame(name), Button = btn, Icon = icon, Window = Window, Subs = {}, CurrentSub = 0, _order = 0 }, Tab)
        tabs[i] = tab
        Sidebar.CanvasSize = UDim2.fromOffset(0, slots * SLOT + 12)
        btn.Activated:Connect(function()
            Anim.pop(btn, 0.85, 0.1)
            selectTab(i)
        end)

        function tab:SetName(n) tab.Name = tostring(n) btn.Name = tab.Name if tabs[current] == tab then PageTitle.Text = tab.Name end end
        function tab:SetSub(s) tab.Sub = tostring(s) if tabs[current] == tab then PageSub.Text = tab.Sub end end

        if i == 1 then
            current = 1
            Indicator.Visible = true
            Indicator.Position = UDim2.fromOffset(6, 0)
            setTabState(1, true, true)
            PageTitle.Text = name
            PageSub.Text = tab.Sub
        end
        return tab
    end

    function Window:SelectTab(which)
        local idx = which
        if type(which) == "string" then
            idx = nil
            for i, t in ipairs(tabs) do if t.Name == which then idx = i break end end
        end
        if idx then selectTab(idx) end
    end

    -- ============================================================
    -- OPEN / CLOSE - Enhanced animations
    -- ============================================================
    function Window:Open()
        if isOpen then return end
        isOpen = true

        local fabPos = Vector2.new(Fab.Position.X.Offset, Fab.Position.Y.Offset)
        local s = panelSize()
        local a = gui.AbsoluteSize
