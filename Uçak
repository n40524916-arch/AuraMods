local function startFly()
    local hrp = getHRP()
    if not hrp then return end
    pcall(function() hrp:SetNetworkOwner(player) end)
    if flyBV then flyBV:Destroy() end
    if flyBG then flyBG:Destroy() end
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.new(0,0,0)
    flyBV.Parent = hrp
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.P = 1000
    flyBG.D = 50
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp
end
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
end

RunService.RenderStepped:Connect(function()
    if not PLAYER.fly then
        PLAYER.flyDir = nil
        if flyBV then stopFly() end
        return
    end
    local hrp = getHRP()
    if not hrp then return end
    if not flyBV or flyBV.Parent ~= hrp then startFly() end
    if not flyBV then return end
    local move = Vector3.new(0,0,0)
    local camCF = camera.CFrame
    local dir = PLAYER.flyDir
    if dir == "up" then move = Vector3.new(0,1,0)
    elseif dir == "down" then move = Vector3.new(0,-1,0)
    elseif dir == "left" then move = -camCF.RightVector
    elseif dir == "right" then move = camCF.RightVector
    elseif dir == "forward" then move = camCF.LookVector
    end
    if move.Magnitude > 0 then move = move.Unit end
    flyBV.Velocity = move * PLAYER.flySpeed
    flyBG.CFrame = camCF
end)

