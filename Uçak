local function isNeutralColor(bc) if not bc then return true end return NEUTRAL_COLORS[bc.Number] == true end
local function isTeammate(otherPlr)
    if otherPlr == player then return false end
    local myTeam, theirTeam = player.Team, otherPlr.Team
    if myTeam and theirTeam then return myTeam == theirTeam end
    local myTC, theirTC = player.TeamColor, otherPlr.TeamColor
    if myTC and theirTC then
        if isNeutralColor(myTC) or isNeutralColor(theirTC) then return false end
        return myTC.Number == theirTC.Number
    end
    return false
end

