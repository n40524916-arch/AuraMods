-- ==================== KEY ACTIVATION ====================
local function tryKey()
    if keyInput.Text == REQUIRED_KEY then
        keyStatus.Text = T("loading")
        keyStatus.TextColor3 = Color3.fromRGB(80,255,120)
        task.wait(0.3)

        pcall(function() keyGui:Destroy() end)

        task.spawn(function()
            task.wait(0.3)
            pcall(function() showRobloxNotif("AuraMods", T("welcome"), "", 3) end)
        end)

        task.defer(function() Window:Open() end)
    else
        keyStatus.Text = T("invalid_key")
        keyStatus.TextColor3 = Color3.fromRGB(255,80,80)
        Anim.shake(keyFrame, 8, 0.3)
    end
end

keyBtn.MouseButton1Click:Connect(tryKey)
keyInput.FocusLost:Connect(function(enterPressed) if enterPressed then tryKey() end end)

