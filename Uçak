local Anim = {}

-- Spring/Elastic/Bounce gibi gelişmiş easing fonksiyonları
local function easeOutBack(t)
    local c1, c3 = 1.70158, 2.70158
    return 1 + c3 * (t - 1)^3 + c1 * (t - 1)^2
end
local function easeOutElastic(t)
    if t == 0 or t == 1 then return t end
    local c4 = (2 * math.pi) / 3
    return 2^(-10 * t) * math.sin((t * 10 - 0.75) * c4) + 1
end
local function easeOutExpo(t)
    return t == 1 and 1 or 1 - 2^(-10 * t)
end
local function easeInOutQuart(t)
    return t < 0.5 and 8 * t * t * t * t or 1 - (-2 * t + 2)^4 / 2
end

-- Yumuşak "spring" tween (Custom animasyon)
function Anim.spring(inst, prop, target, duration, style)
    duration = duration or 0.5
    local t = 0
    local start = inst[prop]
    local token = {}
    inst:SetAttribute("_springToken_" .. prop, tick())
    local myToken = inst:GetAttribute("_springToken_" .. prop)

    task.spawn(function()
        local startTime = tick()
        while true do
            local elapsed = tick() - startTime
            if inst:GetAttribute("_springToken_" .. prop) ~= myToken then return end
            if elapsed >= duration then
                inst[prop] = target
                return
            end
            local p = elapsed / duration
            local eased
            if style == "back" then eased = easeOutBack(p)
            elseif style == "elastic" then eased = easeOutElastic(p)
            elseif style == "expo" then eased = easeOutExpo(p)
            elseif style == "quart" then eased = easeInOutQuart(p)
            else eased = 1 - (1 - p)^3 end

            -- Sayı için interpolasyon
            if typeof(start) == "number" and typeof(target) == "number" then
                inst[prop] = start + (target - start) * eased
            else
                inst[prop] = target
            end
            task.wait()
        end
    end)
end

-- Renk geçiş animasyonu (smooth HSL geçiş)
function Anim.colorTween(inst, prop, target, duration)
    local tw = TweenService:Create(inst, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { [prop] = target })
    tw:Play()
    return tw
end

-- Ölçek-pop animasyonu (basıldığında büyüyüp küçülür)
function Anim.pop(inst, scale, duration)
    scale = scale or 0.85
    duration = duration or 0.15
    local us = inst:FindFirstChildOfClass("UIScale")
    if not us then us = Instance.new("UIScale", inst) end
    local base = 1
    us.Scale = base
    tween_safe(us, { Scale = scale }, duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    task.delay(duration, function()
        tween_safe(us, { Scale = base }, duration * 2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end)
end

-- Ripple efekti (buton tıklamasında dalga)
function Anim.ripple(parent, x, y, color, radius)
    radius = radius or 100
    local rip = Instance.new("Frame")
    rip.AnchorPoint = Vector2.new(0.5, 0.5)
    rip.Position = UDim2.fromOffset(x, y)
    rip.Size = UDim2.fromOffset(0, 0)
    rip.BackgroundColor3 = color or Color3.fromRGB(255,255,255)
    rip.BackgroundTransparency = 0.7
    rip.BorderSizePixel = 0
    rip.ZIndex = 50
    rip.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = rip
    TweenService:Create(rip, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(radius * 2, radius * 2),
        BackgroundTransparency = 1
    }):Play()
    task.delay(0.55, function() if rip.Parent then rip:Destroy() end end)
end

-- Shake animasyonu (input hataları için)
function Anim.shake(inst, intensity, duration)
    intensity = intensity or 5
    duration = duration or 0.3
    local startPos = inst.Position
    task.spawn(function()
        local startTime = tick()
        while tick() - startTime < duration do
            local elapsed = tick() - startTime
            local decay = 1 - (elapsed / duration)
            local dx = math.random(-intensity, intensity) * decay
            local dy = math.random(-intensity, intensity) * decay
            inst.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx, startPos.Y.Scale, startPos.Y.Offset + dy)
            task.wait(0.02)
        end
        inst.Position = startPos
    end)
end

-- Fade-in slide (element belirme animasyonu)
function Anim.slideIn(inst, fromX, fromY, duration)
    fromX = fromX or 0
    fromY = fromY or 20
    duration = duration or 0.4
    local target = inst.Position
    inst.Position = UDim2.new(target.X.Scale, target.X.Offset + fromX, target.Y.Scale, target.Y.Offset + fromY)
    inst.TextTransparency = (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) and 1 or 0
    inst.BackgroundTransparency = inst:IsA("GuiObject") and math.min(inst.BackgroundTransparency + 0.5, 1) or 0
    TweenService:Create(inst, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = target,
        TextTransparency = 0,
        BackgroundTransparency = inst:IsA("TextLabel") and 1 or 0.2
    }):Play()
end

-- Safe tween helper
local function tween_safe(inst, props, dur, style, dir)
    local tw = TweenService:Create(inst, TweenInfo.new(dur or 0.3, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

-- Pulse animasyonu (sürekli nefes alma efekti)
function Anim.pulse(inst, prop, base, amplitude, speed)
    task.spawn(function()
        local t = 0
        while inst.Parent do
            t = t + (speed or 0.05)
            inst[prop] = base + math.sin(t) * amplitude
            task.wait(0.03)
        end
    end)
end

