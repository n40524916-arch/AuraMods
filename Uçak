-- Drag system
local activeDrag = nil
local function endDrag()
    local d = activeDrag
    activeDrag = nil
    if d and d.OnEnd then d.OnEnd() end
end
local function beginDrag(input, onMove, onEnd, callInitial)
    if activeDrag then endDrag() end
    activeDrag = { Input = input, OnMove = onMove, OnEnd = onEnd }
    if callInitial then onMove(input) end
end

