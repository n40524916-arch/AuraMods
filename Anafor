                    local col=getEspColor(p,vis)
                    if ESP.chams and c.hl then
                        if c.hl.Adornee~=ch then c.hl.Adornee=ch end
                        c.hl.Enabled=true; c.hl.FillColor=col; c.hl.OutlineColor=col
                        c.hl.FillTransparency=0.5; c.hl.OutlineTransparency=0
                    elseif c.hl then c.hl.Enabled=false end
                    if hasDrawing and c.box then
                        local hp,ho=camera:WorldToViewportPoint(hd.Position+Vector3.new(0,0.6,0))
                        local fp,fo=camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
                        if ho and fo and hp.Z>0 then
                            local h=math.abs(hp.Y-fp.Y)
                            local w=h*0.55
                            local bx=hp.X-w/2
                            local by=hp.Y
                            if ESP.box then
                                c.box.Visible=true; c.box.Position=Vector2.new(bx,by)
                                c.box.Size=Vector2.new(w,h); c.box.Color=col
                            else c.box.Visible=false end
                            if ESP.corner then
                                local cs=math.min(w,h)*0.25
                                local pts={{bx,by,bx+cs,by},{bx,by,bx,by+cs},{bx+w,by,bx+w-cs,by},{bx+w,by,bx+w,by+cs},{bx,by+h,bx+cs,by+h},{bx,by+h,bx,by+h-cs},{bx+w,by+h,bx+w-cs,by+h},{bx+w,by+h,bx+w,by+h-cs}}
                                for i,l in ipairs(c.corners) do
                                    local pt=pts[i]
                                    l.Visible=true
                                    l.From=Vector2.new(pt[1],pt[2])
                                    l.To=Vector2.new(pt[3],pt[4])
                                    l.Color=col
                                end
                            else for _,l in pairs(c.corners) do l.Visible=false end end
                            if ESP.health and hum then
                                local hp=math.clamp(hum.Health/hum.MaxHealth,0,1)
                                local hw=4; local hh=h; local hx=bx-7; local hy=by
                                c.hBg.Visible=true; c.hBg.Position=Vector2.new(hx,hy)
                                c.hBg.Size=Vector2.new(hw,hh); c.hBg.Color=Color3.fromRGB(20,20,20)
                                c.hBar.Visible=true; c.hBar.Position=Vector2.new(hx,hy+hh*(1-hp))
                                c.hBar.Size=Vector2.new(hw,hh*hp); c.hBar.Color=Color3.fromRGB(0,255,90)
                            else c.hBg.Visible=false; c.hBar.Visible=false end
                            if ESP.name then
                                c.name.Visible=true; c.name.Position=Vector2.new(hp.X,by-20)
                                c.name.Text=p.Name; c.name.Color=col
                            else c.name.Visible=false end
                            if ESP.distance then
                                c.dist.Visible=true; c.dist.Position=Vector2.new(hp.X,by+h+14)
                                c.dist.Text=tostring(math.floor((camera.CFrame.Position-hrp.Position).Magnitude))
