local function isVisibleToCamera(p,hrp)
    if not hrp then return false end
    local o=camera.CFrame.Position
    local d=hrp.Position-o
    local f={camera,espFolder}
    if p.Character then table.insert(f,p.Character) end
    if player.Character then table.insert(f,player.Character) end
    local r=workspace:Raycast(o,d,makeRaycastParams(f))
    return r==nil
end

local function newEsp()
    local c={}
    local h=Instance.new("Highlight")
    h.Name="AM_HL"; h.FillTransparency=0.5; h.OutlineTransparency=0
    h.FillColor=COL_VIS; h.OutlineColor=COL_VIS
    pcall(function() h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop end)
    h.Enabled=false; h.Adornee=nil; h.Parent=espFolder
    c.hl=h
    if hasDrawing then
        pcall(function()
            c.box=Drawing.new("Square"); c.box.Visible=false; c.box.Thickness=1; c.box.Filled=false
            c.corners={}
            for i=1,8 do local l=Drawing.new("Line"); l.Visible=false; l.Thickness=2; c.corners[i]=l end
            c.hBg=Drawing.new("Square"); c.hBg.Visible=false; c.hBg.Thickness=0; c.hBg.Filled=true; c.hBg.Transparency=0.3; c.hBg.Color=Color3.fromRGB(0,0,0)
            c.hBar=Drawing.new("Square"); c.hBar.Visible=false; c.hBar.Thickness=0; c.hBar.Filled=true; c.hBar.Transparency=0.15
            c.name=Drawing.new("Text"); c.name.Visible=false; c.name.Size=16; c.name.Center=true; c.name.Outline=true; c.name.OutlineColor=Color3.fromRGB(0,0,0); c.name.Font=2
            c.dist=Drawing.new("Text"); c.dist.Visible=false; c.dist.Size=14; c.dist.Center=true; c.dist.Outline=true; c.dist.OutlineColor=Color3.fromRGB(0,0,0); c.dist.Font=2
            c.tracer=Drawing.new("Line"); c.tracer.Visible=false; c.tracer.Thickness=1
            c.headDot=Drawing.new("Circle"); c.headDot.Visible=false; c.headDot.Thickness=1; c.headDot.Filled=true; c.headDot.Radius=4
            c.sk=Drawing.new("Text"); c.sk.Visible=false; c.sk.Size=14; c.sk.Center=true; c.sk.Outline=true
            c.arrow=Drawing.new("Triangle"); c.arrow.Visible=false; c.arrow.Filled=true
        end)
    end
    return c
end

local function removeEsp(c)
    if c.hl then pcall(function() c.hl:Destroy() end) end
    if hasDrawing then
        pcall(function()
            for _,k in ipairs({"box","hBg","hBar","name","dist","tracer","headDot","arrow"}) do
                if c[k] then c[k]:Remove() end
            end
            if c.corners then for _,l in pairs(c.corners) do l:Remove() end end
        end)
    end
end

local function hideEsp(c)
    if c.hl then c.hl.Enabled=false end
    if hasDrawing then
        pcall(function()
            for _,k in ipairs({"box","hBg","hBar","name","dist","tracer","headDot","arrow"}) do
                if c[k] then c[k].Visible=false end
            end
            if c.corners then for _,l in pairs(c.corners) do l.Visible=false end end
        end)
    end
end

