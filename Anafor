            writeSaved({Key=key,Start=info.Start})
            keyToast("key_ok","Success",{plan=planText(info,T)})
            local tw=tween(Panel,0.35,{Size=UDim2.fromOffset(W*0.9,H*0.9),GroupTransparency=1},Enum.EasingStyle.Quint,Enum.EasingDirection.InOut)
            tw.Completed:Once(function()
                Panel:Destroy()
                pass(info)
            end)
        end
        local function attempt(force)
            if busy then return end
            local key=normalize(Box.Text)
            if key=="" then
                if force then keyToast("key_empty","Warning"); shake() end
                return
            end
            local info=evaluate(key,now())
            if info then success(info,key); return end
            if force or #key>=KEY_LEN then
                shake()
                if key~=lastBad then lastBad=key; keyToast("key_bad","Error") end
            end
        end
        Box:GetPropertyChangedSignal("Text"):Connect(function()
            if busy then return end
            if normalize(Box.Text)~=lastBad then lastBad=nil end
            attempt(false)
        end)
        Box.Focused:Connect(function() tween(Field,0.15,{BackgroundColor3=FOCUS_BG},Enum.EasingStyle.Sine) end)
        Box.FocusLost:Connect(function(enterPressed)
            tween(Field,0.15,{BackgroundColor3=THEME.Off},Enum.EasingStyle.Sine)
            if enterPressed then attempt(true) end
        end)
        Paste.Activated:Connect(function()
            if busy then return end
            local text=readClipboard()
            if text==nil then keyToast("key_paste_fail","Warning"); shake(); return end
            local key=normalize(text)
            if key=="" then keyToast("key_paste_none","Warning"); return end
            Box.Text=key
            attempt(true)
        end)
        Panel.Visible=true
        tween(Panel,0.45,{Size=UDim2.fromOffset(W,H),GroupTransparency=0})
        typeText(Title,NAME,0.045)
        Tag.TextTransparency=1
        task.delay(0.4,function()
            if Tag.Parent then tween(Tag,0.5,{TextTransparency=0},Enum.EasingStyle.Sine) end
        end)
    end
    function Library:RequireKey(onSuccess)
        local function pass(info)
            accept(info)
            if type(onSuccess)=="function" then onSuccess(info) end
        end
        local saved=readSaved()
        if type(saved)=="table" and saved.Key~=nil then
            local info,reason
            local started=tonumber(saved.Start)
            if started and type(saved.Key)=="string" then info,reason=evaluate(saved.Key,started) end
            if info then pass(info); return true end
            clearSaved()
            keyToast(reason=="expired" and "key_expired" or "key_bad","Warning")
        end
        showPanel(pass)
        return false
    end
end

