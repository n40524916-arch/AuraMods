local function svgNumbers(str)
    local out={}
    for n in tostring(str):gmatch("[-+]?%d*%.?%d+") do out[#out+1]=tonumber(n) end
    return out
end
local function svgAttrs(body)
    local a={}
    for k,v in body:gmatch("([%w%-:_]+)%s*=%s*\"([^\"]*)\"") do a[k:lower()]=v end
    for k,v in body:gmatch("([%w%-:_]+)%s*=%s*'([^']*)'") do a[k:lower()]=v end
    return a
end
local function cubic(p0,c1,c2,p1,n)
    local pts={}
    for i=0,n do
        local t=i/n
        local u=1-t
        pts[#pts+1]={u*u*u*p0[1]+3*u*u*t*c1[1]+3*u*t*t*c2[1]+t*t*t*p1[1],u*u*u*p0[2]+3*u*u*t*c1[2]+3*u*t*t*c2[2]+t*t*t*p1[2]}
    end
    return pts
end
local function svgPath(d)
    local polys,cur={},nil
    local x,y,sx,sy=0,0,0,0
    local function moveTo(px,py) x,y,sx,sy=px,py,px,py; cur={{px,py}}; polys[#polys+1]=cur end
    local function lineTo(px,py)
        if not cur then cur={{x,y}}; polys[#polys+1]=cur end
        cur[#cur+1]={px,py}; x,y=px,py
    end
    for cmd,args in d:gmatch("(%a)([^%a]*)") do
        local nums=svgNumbers(args)
        local c=cmd:lower()
        local rel=(cmd==c)
        local i=1
        if c=="z" then
            if cur then lineTo(sx,sy) end
            cur=nil; x,y=sx,sy
        elseif c=="m" then
            local first=true
            while i+1<=#nums do
                local px,py=nums[i],nums[i+1]
                if rel then px,py=x+px,y+py end
                if first then moveTo(px,py); first=false else lineTo(px,py) end
                i=i+2
            end
        elseif c=="l" then
            while i+1<=#nums do
                local px,py=nums[i],nums[i+1]
                if rel then px,py=x+px,y+py end
                lineTo(px,py); i=i+2
            end
        elseif c=="h" then
            while i<=#nums do lineTo(rel and x+nums[i] or nums[i],y); i=i+1 end
        elseif c=="v" then
            while i<=#nums do lineTo(x,rel and y+nums[i] or nums[i]); i=i+1 end
        elseif c=="c" then
            while i+5<=#nums do
                local ox,oy=rel and x or 0,rel and y or 0
                local pts=cubic({x,y},{ox+nums[i],oy+nums[i+1]},{ox+nums[i+2],oy+nums[i+3]},{ox+nums[i+4],oy+nums[i+5]},10)
                for k=2,#pts do lineTo(pts[k][1],pts[k][2]) end
                i=i+6
            end
        elseif c=="q" then
            while i+3<=#nums do
                local ox,oy=rel and x or 0,rel and y or 0
                local pts=curve({x,y},{ox+nums[i],oy+nums[i+1]},{ox+nums[i+2],oy+nums[i+3]},10)
                for k=2,#pts do lineTo(pts[k][1],pts[k][2]) end
                i=i+4
            end
        else
            local per=({s=4,t=2,a=7})[c]
            if per then
                while i+per-1<=#nums do
                    local px,py=nums[i+per-2],nums[i+per-1]
                    if rel then px,py=x+px,y+py end
                    lineTo(px,py); i=i+per
                end
            end
        end
    end
    return polys
end
function Library:ParseSvg(svg)
    svg=tostring(svg)
    local lines,dots={},{}
    local vbx,vby,vbw,vbh=0,0,VB,VB
    local strokeW
    local function addLine(pts) if #pts>=2 then lines[#lines+1]=pts end end
    for tag,body in svg:gmatch("<(%a+)([^>]*)>") do
        tag=tag:lower()
        local a=svgAttrs(body)
        if tag=="svg" then
            if a.viewbox then
                local n=svgNumbers(a.viewbox)
                if #n>=4 and n[3]>0 and n[4]>0 then vbx,vby,vbw,vbh=n[1],n[2],n[3],n[4] end
            end
            strokeW=tonumber(a["stroke-width"])
        elseif tag=="path" and a.d then
            for _,poly in ipairs(svgPath(a.d)) do addLine(poly) end
        elseif tag=="line" then
            addLine({{tonumber(a.x1) or 0,tonumber(a.y1) or 0},{tonumber(a.x2) or 0,tonumber(a.y2) or 0}})
        elseif tag=="polyline" or tag=="polygon" then
            local n=svgNumbers(a.points or "")
            local pts={}
            for i=1,#n-1,2 do pts[#pts+1]={n[i],n[i+1]} end
            if tag=="polygon" and #pts>0 then pts[#pts+1]={pts[1][1],pts[1][2]} end
            addLine(pts)
        elseif tag=="rect" then
            local x,y=tonumber(a.x) or 0,tonumber(a.y) or 0
            local w,h=tonumber(a.width) or 0,tonumber(a.height) or 0
            addLine({{x,y},{x+w,y},{x+w,y+h},{x,y+h},{x,y}})
        elseif tag=="circle" or tag=="ellipse" then
            local cx,cy=tonumber(a.cx) or 0,tonumber(a.cy) or 0
            local rx=tonumber(a.rx) or tonumber(a.r) or 0
            local ry=tonumber(a.ry) or tonumber(a.r) or rx
            local filled=a.fill~=nil and a.fill~="none"
            if filled and rx==ry then dots[#dots+1]={cx,cy,rx}
            else
                local pts={}
                for i=0,24 do
                    local ang=(i/24)*math.pi*2
                    pts[#pts+1]={cx+math.cos(ang)*rx,cy+math.sin(ang)*ry}
                end
                addLine(pts)
            end
        end
    end
    local scale=VB/math.max(vbw,vbh)
    local outLines,outDots={},{}
    for _,l in ipairs(lines) do
        local o={}
        for i,p in ipairs(l) do o[i]={(p[1]-vbx)*scale,(p[2]-vby)*scale} end
        outLines[#outLines+1]=o
    end
    for _,d in ipairs(dots) do outDots[#outDots+1]={(d[1]-vbx)*scale,(d[2]-vby)*scale,d[3]*scale} end
    if #outLines==0 and #outDots==0 then return nil,"SVG icinde cizilebilir sekil yok" end
    return {lines=outLines,dots=outDots,stroke=strokeW and strokeW*scale or nil}
end

