                                c.tracer.To=Vector2.new(hp.X,hp.Y); c.tracer.Color=col
                            else c.tracer.Visible=false end
                            if ESP.headDot then
                                c.headDot.Visible=true; c.headDot.Position=Vector2.new(hp.X,hp.Y); c.headDot.Color=col
                            else c.headDot.Visible=false end
                            if c.sk then c.sk.Visible=false end
                            if c.arrow then c.arrow.Visible=false end
                        else
                            if c.arrow then
                                local pp,on=camera:WorldToViewportPoint(hrp.Position)
                                if not on or pp.Z<=0 then
                                    local sc=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
                                    local d=(Vector2.new(pp.X,pp.Y)-sc)
