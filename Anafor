local ELEMENT_METHODS={info="AddInfo",label="AddLabel",section="AddSection",toggle="AddToggle",button="AddButton",slider="AddSlider",input="AddInput",dropdown="AddDropdown",colorpicker="AddColorPicker",color="AddColorPicker"}
local TEXT_KEYS={"Name","Value","Text","Placeholder","Suffix"}

local function buildElement(target,el,ctx)
    if type(el)~="table" then return nil end
    local kind=tostring(el.Type or ""):lower()
    local method=ELEMENT_METHODS[kind]
    if not method then warn("[AuraMods] Bilinmeyen eleman tipi: '"..tostring(el.Type).."'"); return nil end
    local o={}
    for k,v in pairs(el) do o[k]=v end
    for _,k in ipairs(TEXT_KEYS) do o[k]=fillVars(o[k]) end
    if o.Color~=nil then o.Color=toColor(o.Color) end
    if kind=="colorpicker" or kind=="color" then o.Default=toColor(o.Default) end
    local fireInit=o.FireOnCreate
    o.FireOnCreate=nil
    local label=tostring(o.Name or o.Text or kind)
    local ref={Window=ctx.Window,Library=Library}
    local runCode=makeRunner(el.Code,label,ref)
    local runOn,runOff
    if kind=="toggle" then
        runOn=makeRunner(el.CodeOn,label..".CodeOn",ref)
        runOff=makeRunner(el.CodeOff,label..".CodeOff",ref)
    end
    o.Callback=function(value)
        if kind=="toggle" then
            if value and runOn then runOn(value)
            elseif not value and runOff then runOff(value) end
        end
        if runCode then runCode(value) end
        if el.Run~=nil then
            local handler=Library.Handlers[el.Run]
            if type(handler)=="function" then
                local ok,err=pcall(handler,value,ref)
                if not ok then warn("[AuraMods] Run hatasi ("..tostring(el.Run).."): "..tostring(err)) end
            else warn("[AuraMods] Run bulunamadi: "..tostring(el.Run)) end
        end
        doNotify(el.Notify,label,value)
    end
    local api=target[method](target,o)
    ref.Element=api
    if o.Flag then Library.Elements[o.Flag]=api end
    if o.Visible==false then api:SetVisible(false) end
    if fireInit and api.Get then fire(o.Callback,api:Get()) end
    return api
end

local function decodeJSON(text)
    local ok,res=pcall(function() return HttpService:JSONDecode(text) end)
    if ok then return res end
    local fixed=text:gsub(",(%s*[}%]])","%1")
    if fixed~=text then
        local ok2,res2=pcall(function() return HttpService:JSONDecode(fixed) end)
        if ok2 then
            warn("[AuraMods] JSON'da fazladan virgul vardi, otomatik duzeltildi.")
            return res2
        end
    end
    return nil,tostring(res)
end

