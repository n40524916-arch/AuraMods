local function buildIcon(parent,def,size,color)
    local root=make("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(size,size),BackgroundTransparency=1,ZIndex=3,Parent=parent})
    local parts={}
