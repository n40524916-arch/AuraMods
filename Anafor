local function getAimbotTarget()
    local cl,cd=nil,math.huge
    local sc=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=player then
            local team=isTeammate(p)
            if not (AIM.teamCheck and team) then
                local ch=p.Character
                local pt=ch and (ch:FindFirstChild(AIM.targetPart) or ch:FindFirstChild("Head"))
                local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
                local hum=ch and ch:FindFirstChildOfClass("Humanoid")
                if pt and hrp and hum and hum.Health>0 then
                    local v=true
                    if AIM.visibleOnly then v=isVisibleToCamera(p,hrp) end
                    if v then
                        local pos,on=camera:WorldToViewportPoint(pt.Position)
                        if on and pos.Z>0 then
                            local d=(Vector2.new(pos.X,pos.Y)-sc).Magnitude
                            if d<=AIM.fov and d<cd then cd=d; cl=pt end
                        end
                    end
                end
            end
        end
    end
    return cl
end

RunService.RenderStepped:Connect(function()
    if aimCircle then
        aimCircle.Visible=AIM.enabled and AIM.showFov
        aimCircle.Radius=AIM.fov; aimCircle.Color=Color3.new(1,1,1)
        pcall(function() aimCircle.Position=Vector2.new(camera.ViewportSize.X/2,camera.ViewportSize.Y/2) end)
    end
    if not AIM.enabled then return end
    local mobile=UserInputService.TouchEnabled
    if not mobile and not aimActive then return end
    local t=getAimbotTarget()
    if not t then return end
    local tp=t.Position
    if AIM.prediction and AIM.prediction>0 then
        local v=t.AssemblyLinearVelocity or t.Velocity or Vector3.new(0,0,0)
        tp=tp+v*AIM.prediction
    end
    local cur=camera.CFrame
    local tc=CFrame.new(cur.Position,tp)
    local nc=cur:Lerp(tc,math.clamp(AIM.smoothness,0.01,1))
    pcall(function() camera.CFrame=nc end)
end)

