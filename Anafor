do
    local KEY_FILE="AuraMods/key.json"
    local DAY=86400
    local MONTH=30*DAY
    local KEYS={
        ["AURAMODS_000000000_ROBLOX"]={Unlimited=true},
        ["AURAMODS_830728511_ROBLOX"]={Months=1},
        ["AURAMODS_070707070_ROBLOX"]={Months=99},
    }
    local KEY_LEN,SAMPLE_KEY=0,""
    for k in pairs(KEYS) do
        if #k>KEY_LEN then KEY_LEN,SAMPLE_KEY=#k,k end
    end
    Library.Vars.KeyPlan="-"
    Library.Vars.KeyLeft="-"
    local function T(key,vars)
        local s=Library.Locales.en[key] or tostring(key)
        if vars then
            s=(s:gsub("{(%w+)}",function(k)
                local v=vars[k]
                if v==nil then return nil end
                return tostring(v)
            end))
        end
        return s
    end
    local function normalize(text) return (tostring(text or ""):gsub("[%s\"'`]","")):upper() end
    local function now()
        local ok,t=pcall(function() return workspace:GetServerTimeNow() end)
        if ok and type(t)=="number" and t>0 then return math.floor(t) end
        return os.time()
    end
    local function session()
        local ok,env=pcall(function()
            if type(getgenv)=="function" then return getgenv() end
            return shared
        end)
        if ok and type(env)=="table" then return env end
        return nil
    end
    local function readSaved()
        if fsOK then
            local okE,exists=pcall(isfile,KEY_FILE)
            if not okE or not exists then return nil end
            local ok,body=pcall(readfile,KEY_FILE)
            if not ok then return nil end
            local okJ,data=pcall(function() return HttpService:JSONDecode(body) end)
            if okJ and type(data)=="table" then return data end
            return nil
        end
        local s=session()
        return s and s.AuraModsKey or nil
    end
    local function writeSaved(data)
        if fsOK then
            ensureDirs()
            pcall(function() writefile(KEY_FILE,HttpService:JSONEncode(data)) end)
            return
        end
        local s=session()
        if s then s.AuraModsKey=data end
    end
    local function clearSaved()
        if fsOK then
            if type(delfile)=="function" then pcall(delfile,KEY_FILE)
            else pcall(writefile,KEY_FILE,"{}") end
            return
        end
        local s=session()
        if s then s.AuraModsKey=nil end
    end
    local function readClipboard()
        local ok,text=pcall(function()
            if type(getclipboard)=="function" then return getclipboard() end
            if type(readclipboard)=="function" then return readclipboard() end
            return nil
        end)
        if ok and type(text)=="string" then return text end
        return nil
    end
    local function evaluate(key,startedAt)
        local def=KEYS[key]
        if not def then return nil,"bad" end
        local info={Key=key,Start=startedAt,Months=def.Months}
        if def.Months then
            local total=def.Months*MONTH
            local left=math.min(startedAt+total-now(),total)
            if left<=0 then return nil,"expired" end
            info.Left=left
        end
        return info
    end
    local function planText(info,t)
        t=t or L
        if not info.Months then return t("key_unlimited") end
        return t(info.Months==1 and "key_month" or "key_months",{n=info.Months})
    end
    local function leftText(info,t)
        t=t or L
        if not info.Left then return t("key_unlimited") end
        local days=math.floor(info.Left/DAY)
        if days>=1 then return t(days==1 and "key_day" or "key_days",{n=days}) end
        local hours=math.max(1,math.ceil(info.Left/3600))
        return t(hours==1 and "key_hour" or "key_hours",{n=hours})
    end
    local function accept(info)
        Library.KeyInfo=info
        Library.Vars.KeyPlan=planText(info)
        Library.Vars.KeyLeft=leftText(info)
    end
