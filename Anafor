local function fillVars(s)
    if type(s)~="string" or not s:find("{",1,true) then return s end
    return (s:gsub("{(%w+)}",function(k)
        local v=Vars[k]
        if v==nil then return nil end
        return tostring(v)
    end))
end
local function toColor(v)
    if typeof(v)=="Color3" then return v end
    if type(v)=="string" then return fromHex(v) end
    if type(v)=="table" and #v>=3 then return Color3.fromRGB(v[1],v[2],v[3]) end
    return nil
end
local function valueText(v)
    if type(v)=="table" then
        local out={}
        for _,x in ipairs(v) do out[#out+1]=tostring(x) end
        return table.concat(out,", ")
    end
    if typeof(v)=="Color3" then return toHex(v) end
    return tostring(v)
end
local function codeToString(c)
    if type(c)=="table" then
        local parts={}
        for _,line in ipairs(c) do parts[#parts+1]=tostring(line) end
        return table.concat(parts,"\n")
    end
    if type(c)=="string" then return c end
    return nil
end

local compileLua=loadstring or load
local noLoadWarned=false
local CODE_HEADER="local Value, Library, Window, Flags, Element, Player = ...\n"

local function makeRunner(code,label,ref)
    local src=codeToString(code)
    if not src or src:match("^%s*$") then return nil end
    local fn,failed=nil,false
    return function(value)
        if failed then return end
        if not fn then
            if not compileLua then
                if not noLoadWarned then
                    noLoadWarned=true
                    warn("[AuraMods] loadstring yok: JSON 'Code' alanlari calismaz.")
                end
                failed=true
                return
            end
            local okc,f,err=pcall(compileLua,CODE_HEADER..src,"=AuraMods:"..label)
            if not okc then err,f=f,nil end
            if not f then
                warn("[AuraMods] Kod hatasi ("..label.."): "..tostring(err))
                failed=true
                return
            end
            fn=f
        end
        local ok,err=pcall(fn,value,Library,ref.Window,Library.Flags,ref.Element,player)
        if not ok then warn("[AuraMods] Kod calisirken hata ("..label.."): "..tostring(err)) end
    end
end

local function doNotify(spec,name,value)
    if spec==nil or Library._loading then return end
    if type(spec)=="table" and spec[1]~=nil then
        for _,one in ipairs(spec) do doNotify(one,name,value) end
        return
    end
    local n=type(spec)=="table" and spec or {Content=tostring(spec)}
    local text=valueText(value)
    local function sub(s)
        if s==nil then return nil end
        return (fillVars(tostring(s)):gsub("{Value}",function() return text end))
    end
    Library:Notify({Title=sub(n.Title) or name,Content=sub(n.Content),Duration=n.Duration,Type=n.Type})
end

