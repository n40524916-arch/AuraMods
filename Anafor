local function makeRaycastParams(f)
    local p=RaycastParams.new()
    local ok=pcall(function() p.FilterType=Enum.RaycastFilterType.Exclude end)
    if not ok then pcall(function() p.FilterType=Enum.RaycastFilterType.Blacklist end) end
    p.FilterDescendantsInstances=f or {}
    return p
end

local NC={
    [BrickColor.new("White").Number]=true,
    [BrickColor.new("Medium stone grey").Number]=true,
    [BrickColor.new("Light stone grey").Number]=true,
    [BrickColor.new("Institutional white").Number]=true,
    [BrickColor.new("Ghost grey").Number]=true,
    [BrickColor.new("Dark stone grey").Number]=true,
}
local function isNC(b) if not b then return true end return NC[b.Number]==true end
local function isTeammate(o)
    if o==player then return false end
    local mt=player.Team; local tt=o.Team
    if mt and tt then return mt==tt end
    local a=player.TeamColor; local b=o.TeamColor
    if a and b then
        if isNC(a) or isNC(b) then return false end
        return a.Number==b.Number
    end
    return false
end

