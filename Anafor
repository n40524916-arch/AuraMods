local THEME_LIST={"Default","Blue","Purple","Pink","Green","Rainbow"}
Library.Themes.Blue={Fg=Color3.fromRGB(74,144,255)}
Library.Themes.Purple={Fg=Color3.fromRGB(167,107,255)}
Library.Themes.Pink={Fg=Color3.fromRGB(255,95,170)}
Library.Themes.Green={Fg=Color3.fromRGB(52,211,120)}
Library.Themes.Rainbow={Fg=Color3.fromHSV(0,0.75,1),Rainbow=true}

local function colorKey(c)
    return math.floor(c.R*255+0.5)*65536+math.floor(c.G*255+0.5)*256+math.floor(c.B*255+0.5)
end
local function themeSkipped(inst)
    local p=inst
    while p and p~=gui do
        if p:GetAttribute("ThemeForce") then return false end
        if p:GetAttribute("NoTheme") then return true end
        p=p.Parent
    end
    return false
end
local function recolorAll(map)
    local function swap(inst,prop)
        local n=map[colorKey(inst[prop])]
        if n then inst[prop]=n end
    end
    for _,inst in ipairs(gui:GetDescendants()) do
        if inst:IsA("UIStroke") then
            if not themeSkipped(inst) then swap(inst,"Color") end
        elseif inst:IsA("GuiObject") and not themeSkipped(inst) then
            swap(inst,"BackgroundColor3")
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then swap(inst,"TextColor3") end
            if inst:IsA("TextBox") then swap(inst,"PlaceholderColor3") end
            if inst:IsA("ScrollingFrame") then swap(inst,"ScrollBarImageColor3") end
        end
    end
end
local themeToken=0
local rainbowConn=nil
local whiteSeen={}
local BG_PROPS={"BackgroundColor3"}
local TEXT_PROPS={"BackgroundColor3","TextColor3"}
local STROKE_PROPS={"Color"}
local function stopRainbow()
    if rainbowConn then rainbowConn:Disconnect(); rainbowConn=nil end
end
local function startRainbow()
    local t0=os.clock()
    local last,lastScan=0,0
    local tracked={}
    local function rescan()
        tracked={}
        for _,inst in ipairs(gui:GetDescendants()) do
            local props
            if inst:IsA("UIStroke") then props=STROKE_PROPS
            elseif inst:IsA("GuiObject") then
                if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then props=TEXT_PROPS
                else props=BG_PROPS end
            end
            if props then
                local skipped=nil
                for _,prop in ipairs(props) do
                    if whiteSeen[colorKey(inst[prop])] then
                        if skipped==nil then skipped=themeSkipped(inst) end
                        if not skipped then tracked[#tracked+1]={inst,prop} end
                    end
                end
            end
        end
    end
    rainbowConn=RunService.Heartbeat:Connect(function()
        if not gui.Parent then stopRainbow(); return end
        local now=os.clock()
        if now-last<0.05 then return end
        last=now
        if now-lastScan>0.4 then lastScan=now; rescan() end
        local c=Color3.fromHSV(((now-t0)*0.15)%1,0.75,1)
        THEME.Fg=c
        THEME.Accent=c
        whiteSeen[colorKey(c)]=now
        for k,t in pairs(whiteSeen) do
            if now-t>3 then whiteSeen[k]=nil end
        end
        for i=#tracked,1,-1 do
            local e=tracked[i]
            local inst,prop=e[1],e[2]
            if inst.Parent and whiteSeen[colorKey(inst[prop])] then inst[prop]=c
            else table.remove(tracked,i) end
        end
    end)
    table.insert(conns,rainbowConn)
end
function Library:SetTheme(name)
    local new=Library.Themes[name]
    if not new then return false end
    stopRainbow()
    local now=os.clock()
    whiteSeen[colorKey(THEME.Fg)]=now
    whiteSeen[colorKey(THEME.Accent)]=now
    local target=new.Fg or Library.Themes.Default.Fg
    local map={}
    for k in pairs(whiteSeen) do map[k]=target end
    for k,v in pairs(new) do
        if THEME[k]~=nil and typeof(v)=="Color3" then THEME[k]=v end
    end
    THEME.Accent=THEME.Fg
    table.clear(whiteSeen)
    whiteSeen[colorKey(THEME.Fg)]=now
    Library.ThemeName=name
    recolorAll(map)
    themeToken=themeToken+1
    local mine=themeToken
    if new.Rainbow then startRainbow()
    else
        task.delay(0.6,function()
            if mine==themeToken and gui.Parent then recolorAll(map) end
        end)
    end
    return true
end
function Library:SetUIScale(v)
    SET.UIScale=math.clamp(tonumber(v) or SCALE_BASE,0.5,2)
    if Library.Window and Library.Window.SetScale then Library.Window:SetScale()
    else applyToastPosition() end
end

