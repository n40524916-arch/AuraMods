        if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
    end)
end
local function cleanName(n)
    n=tostring(n or ""):gsub("[\\/:*?\"<>|%c]",""):gsub("^%s+",""):gsub("%s+$","")
    if (utf8.len(n) or #n)>24 then n=n:sub(1,(utf8.offset(n,25) or (#n+1))-1) end
    return n
end
local function encodeValue(v)
    if typeof(v)=="Color3" then return {__c=toHex(v)} end
    if type(v)=="table" then
        local o={}
        for i,x in ipairs(v) do o[i]=encodeValue(x) end
        return o
    end
    return v
end
local function decodeValue(v)
    if type(v)=="table" then
        if v.__c then return fromHex(v.__c) end
        local o={}
        for i,x in ipairs(v) do o[i]=decodeValue(x) end
        return o
    end
    return v
end
local function readConfig(name)
    local json
    if fsOK then
        local path=CFG_DIR.."/"..name..".json"
        local okE,exists=pcall(isfile,path)
        if not okE or not exists then return nil end
        local ok,body=pcall(readfile,path)
        if not ok then return nil end
        json=body
    else json=mem.Configs[name] end
    if not json then return nil end
    local ok,data=pcall(function() return HttpService:JSONDecode(json) end)
    if ok and type(data)=="table" then return data end
    return nil
end
function Library:SaveConfig(name)
    name=cleanName(name)
    if name=="" then return false,"name" end
    local data={Version=1,Name=name,Flags={}}
    for flag,value in pairs(Library.Flags) do
        if value~=nil then data.Flags[flag]=encodeValue(value) end
    end
    local ok,json=pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false,tostring(json) end
    if fsOK then
        ensureDirs()
        local ok2,err=pcall(writefile,CFG_DIR.."/"..name..".json",json)
        if not ok2 then return false,tostring(err) end
    else mem.Configs[name]=json end
    return true,name
end
function Library:ListConfigs()
    local out={}
    if fsOK then
        ensureDirs()
        local ok,files=pcall(listfiles,CFG_DIR)
        if ok and type(files)=="table" then
            for _,f in ipairs(files) do
                local n=tostring(f):match("([^/\\]+)%.json$")
                if n then out[#out+1]=n end
            end
        end
    else for n in pairs(mem.Configs) do out[#out+1]=n end end
    table.sort(out,function(a,b) return a:lower()<b:lower() end)
    return out
end
function Library:LoadConfig(name)
    name=cleanName(name)
    local data=readConfig(name)
    if not data or type(data.Flags)~="table" then return false end
    Library._loading=true
    local ok,err=pcall(function()
        for flag,raw in pairs(data.Flags) do
            local el=Library.Elements[flag]
            if el and el.Set then
                local okSet,errSet=pcall(el.Set,el,decodeValue(raw))
                if not okSet then warn("[AuraMods] Config uygulanamadi ("..tostring(flag).."): "..tostring(errSet)) end
            end
        end
    end)
    Library._loading=false
    if not ok then warn("[AuraMods] Config hatasi: "..tostring(err)); return false end
    return true
end
function Library:DeleteConfig(name)
    name=cleanName(name)
    if name=="" then return false end
    if Library:GetAutoConfig()==name then Library:SetAutoConfig(nil) end
    if fsOK then
        if type(delfile)~="function" then return false end
        return pcall(delfile,CFG_DIR.."/"..name..".json")
    end
    mem.Configs[name]=nil
    return true
end
function Library:SetAutoConfig(name)
    if name~=nil then
        name=cleanName(name)
        if name=="" then name=nil end
    end
    if fsOK then ensureDirs(); pcall(writefile,AUTO_FILE,name or "") end
    mem.Auto=name
end
function Library:GetAutoConfig()
    if fsOK then
        local okE,exists=pcall(isfile,AUTO_FILE)
        if okE and exists then
            local ok,body=pcall(readfile,AUTO_FILE)
            if ok then
                body=cleanName(body)
                if body~="" then return body end
            end
        end
        return nil
    end
    return mem.Auto
end

