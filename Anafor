    round(swatch,6)
    stroke(swatch,THEME.Muted,1):SetAttribute("ThemeForce",true)
    local hit=make("TextButton",{BackgroundTransparency=1,Text="",Size=UDim2.new(1,0,0,H),ZIndex=5,Parent=row})
    local body=make("Frame",{BackgroundTransparency=1,Position=UDim2.fromOffset(0,H),Size=UDim2.new(1,0,0,BODY),Visible=false,Parent=row})
    local svBox=make("Frame",{Position=UDim2.fromOffset(10,4),Size=UDim2.new(1,-46,0,SV_H),BackgroundColor3=Color3.fromHSV(h,1,1),BorderSizePixel=0,Parent=body})
    svBox:SetAttribute("NoTheme",true)
    round(svBox,6)
    local white=make("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,Parent=svBox})
    round(white,6)
    make("UIGradient",{Transparency=NumberSequence.new(0,1),Parent=white})
    local black=make("Frame",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BorderSizePixel=0,Parent=svBox})
    round(black,6)
    make("UIGradient",{Rotation=90,Transparency=NumberSequence.new(1,0),Parent=black})
    local svCursor=make("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.fromOffset(12,12),BackgroundColor3=color,BorderSizePixel=0,ZIndex=3,Parent=svBox})
    round(svCursor,6)
    stroke(svCursor,Color3.new(1,1,1),2)
    local hueBar=make("Frame",{AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-10,0,4),Size=UDim2.fromOffset(16,SV_H),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,Parent=body})
    hueBar:SetAttribute("NoTheme",true)
    round(hueBar,6)
    local seq={}
    for i=0,6 do seq[#seq+1]=ColorSequenceKeypoint.new(i/6,Color3.fromHSV(i/6,1,1)) end
    make("UIGradient",{Rotation=90,Color=ColorSequence.new(seq),Parent=hueBar})
    local hueCursor=make("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.new(1,4,0,4),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=3,Parent=hueBar})
    round(hueCursor,2)
    stroke(hueCursor,Color3.new(0,0,0),1)
    local hex=make("TextBox",{Position=UDim2.fromOffset(10,SV_H+12),Size=UDim2.new(1,-20,0,24),BackgroundColor3=THEME.Off,BorderSizePixel=0,Text="",PlaceholderText="#RRGGBB",PlaceholderColor3=THEME.Muted,TextColor3=THEME.Fg,Font=FONT_BOLD,TextSize=13,ClearTextOnFocus=false,Parent=body})
    round(hex,8)
    local hexStroke=stroke(hex,THEME.Off,1)
    local function apply(silent)
        color=Color3.fromHSV(h,s,v)
        swatch.BackgroundColor3=color
        svBox.BackgroundColor3=Color3.fromHSV(h,1,1)
        svCursor.Position=UDim2.new(s,0,1-v,0)
        svCursor.BackgroundColor3=color
        hueCursor.Position=UDim2.new(0.5,0,h,0)
        hex.Text=toHex(color)
        setFlag(o.Flag,color)
        if not silent then fire(o.Callback,color) end
    end
    local function dragger(target,onPoint)
        local area=make("TextButton",{BackgroundTransparency=1,Text="",AutoButtonColor=false,Size=UDim2.fromScale(1,1),ZIndex=6,Parent=target})
        area.InputBegan:Connect(function(input)
            if not isPress(input) then return end
            tab.Page.ScrollingEnabled=false
            beginDrag(input,function(i)
                local p=guiPoint(i)
                local ap,as=target.AbsolutePosition,target.AbsoluteSize
                onPoint(math.clamp((p.X-ap.X)/math.max(as.X,1),0,1),math.clamp((p.Y-ap.Y)/math.max(as.Y,1),0,1))
            end,function() tab.Page.ScrollingEnabled=true end,true)
        end)
    end
    dragger(svBox,function(x,y) s,v=x,1-y; apply(false) end)
    dragger(hueBar,function(_,y) h=y; apply(false) end)
    hex.Focused:Connect(function() tween(hexStroke,0.15,{Color=THEME.Accent},Enum.EasingStyle.Sine) end)
    hex.FocusLost:Connect(function()
        tween(hexStroke,0.15,{Color=THEME.Off},Enum.EasingStyle.Sine)
        local c=fromHex(hex.Text)
        if c then h,s,v=c:ToHSV(); apply(false) else hex.Text=toHex(color) end
    end)
    local open=false
    local openToken=0
    local function setOpen(x)
        open=x
        openToken=openToken+1
        local mine=openToken
        if x then body.Visible=true end
        local tw=tween(row,0.3,{Size=UDim2.new(1,0,0,H+(x and BODY or 0))})
        if not x then tw.Completed:Once(function() if openToken==mine then body.Visible=false end end) end
    end
    hit.Activated:Connect(function() setOpen(not open) end)
    local api={}
    function api:Set(c,silent)
        if typeof(c)~="Color3" then return end
        h,s,v=c:ToHSV()
        apply(silent)
    end
    function api:Get() return color end
    function api:Open() setOpen(true) end
    function api:Close() setOpen(false) end
    apply(true)
    if o.FireOnCreate then fire(o.Callback,color) end
    return finish(row,api)
end

function Library:CreateWindow(opts)
    opts=opts or {}
    local Name=opts.Name or "AuraMods"
    local TagText=opts.Tag
    if TagText==nil then TagText="Roblox" end
    local BadgeText=opts.Badge
    if BadgeText==nil then BadgeText="V1 ALPHA" end
    local FabText=opts.FabText or string.sub(Name,1,1)
    local fabStart=opts.FabPosition or UDim2.fromOffset(48,120)
    local minSize=opts.MinSize or Vector2.new(260,270)
    local maxSize=opts.MaxSize or Vector2.new(580,340)

    local Window={}
    local isOpen,current=false,0
    local panelCenter,panelReady=nil,false
    local tabs={}
    local slots=0
    local SLOT,HEADER_H=40,46
    local DOCK_H=50
    local DOCK_LIFT=12

    local fabBase=uiScaleFactor()
    local Fab=make("CanvasGroup",{Name="Fab",AnchorPoint=Vector2.new(0.5,0.5),Position=fabStart,Size=UDim2.fromOffset(44,44),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Active=true,Parent=gui})
    round(Fab,14)
    make("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=FabText,Font=FONT_BLACK,TextSize=22,TextColor3=THEME.Bg,ZIndex=2,Parent=Fab})
    local fabScale=make("UIScale",{Scale=fabBase,Parent=Fab})

    local function fabCenter() return Vector2.new(Fab.Position.X.Offset,Fab.Position.Y.Offset) end
    local function clampFab()
        local a=gui.AbsoluteSize
        local half=26*fabBase
        local c=fabCenter()
        Fab.Position=UDim2.fromOffset(math.clamp(c.X,half,math.max(half,a.X-half)),math.clamp(c.Y,half,math.max(half,a.Y-half)))
    end

    Fab.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        local startPos=Vector2.new(input.Position.X,input.Position.Y)
        local startCenter=fabCenter()
        local moved=false
        tween(fabScale,0.12,{Scale=0.9*fabBase})
        beginDrag(input,function(i)
            local delta=Vector2.new(i.Position.X,i.Position.Y)-startPos
            if not moved and delta.Magnitude>10 then moved=true end
            if moved then
                local a=gui.AbsoluteSize
                local half=26*fabBase
                Fab.Position=UDim2.fromOffset(math.clamp(startCenter.X+delta.X,half,math.max(half,a.X-half)),math.clamp(startCenter.Y+delta.Y,half,math.max(half,a.Y-half)))
            end
        end,function()
            tween(fabScale,0.3,{Scale=fabBase},Enum.EasingStyle.Back)
            if not moved then Window:Open() end
        end)
    end)

    local Panel=make("CanvasGroup",{Name="Panel",AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromOffset(44,44),BackgroundColor3=THEME.Bg,BorderSizePixel=0,GroupTransparency=1,Visible=false,Active=true,Parent=gui})
    Panel.ClipsDescendants=true
    round(Panel,16)
    local panelScale=make("UIScale",{Scale=fabBase,Parent=Panel})

    -- ============================================
    -- SİYAH-BEYAZ BALONCUK ANİMASYONU (MENÜ ARKA PLANI)
    -- ============================================
    local BubbleClip=make("Frame",{
        Name="Bubbles",
        Size=UDim2.fromScale(1,1),
        BackgroundTransparency=1,
        ClipsDescendants=true,
        ZIndex=1,
        Parent=Panel,
    })
    round(BubbleClip,16)
    local function spawnBubble()
        if not BubbleClip.Parent then return end
        local size=math.random(15,60)
        local isWhite=math.random()>0.5
        local b=make("Frame",{
            Size=UDim2.fromOffset(size,size),
            Position=UDim2.new(math.random(),0,1.05,0),
            BackgroundColor3=isWhite and Color3.fromRGB(255,255,255) or Color3.fromRGB(0,0,0),
            BackgroundTransparency=math.random(60,85)/100,
            BorderSizePixel=0,
            ZIndex=1,
            Parent=BubbleClip,
        })
        round(b,size)
        local s=stroke(b,b.BackgroundColor3,1)
        s.Transparency=0.4
        local dur=math.random(6,12)
        local drift=(math.random()-0.5)*0.3
        tween(b,dur,{
            Position=UDim2.new(b.Position.X.Scale+drift,0,-0.15,0),
            BackgroundTransparency=1,
            Rotation=math.random(-180,180),
        },Enum.EasingStyle.Linear)
        tween(s,dur,{Transparency=1},Enum.EasingStyle.Linear)
        task.delay(dur+0.2,function() if b.Parent then b:Destroy() end end)
    end
    task.spawn(function()
        while BubbleClip.Parent do
            spawnBubble()
            task.wait(math.random(3,7)/10)
        end
    end)
    -- ============================================

    local function panelSize()
        local a=gui.AbsoluteSize
        local sc=panelScale.Scale
        local availX,availY=(a.X-48)/sc,(a.Y-32)/sc
        return Vector2.new(
            math.clamp(availX,math.min(minSize.X,availX),maxSize.X),
            math.clamp(availY,math.min(minSize.Y,availY),maxSize.Y)
        )
    end
    local function clampPanelCenter(c,s)
        local a=gui.AbsoluteSize
        local hx,hy=s.X/2,s.Y/2
        return Vector2.new(math.clamp(c.X,hx,math.max(hx,a.X-hx)),math.clamp(c.Y,hy,math.max(hy,a.Y-hy)))
    end
    local function getPanelCenter(s)
        local a=gui.AbsoluteSize
        return clampPanelCenter(panelCenter or Vector2.new(a.X/2,a.Y/2),s*panelScale.Scale)
    end

    local Header=make("Frame",{Name="Header",BackgroundTransparency=1,Active=true,Size=UDim2.new(1,0,0,HEADER_H),ZIndex=10,Parent=Panel})
    Header.InputBegan:Connect(function(input)
        if not panelReady or not isPress(input) then return end
        local startPos=Vector2.new(input.Position.X,input.Position.Y)
        local startCenter=Vector2.new(Panel.Position.X.Offset,Panel.Position.Y.Offset)
        beginDrag(input,function(i)
            local delta=Vector2.new(i.Position.X,i.Position.Y)-startPos
            panelCenter=clampPanelCenter(startCenter+delta,Panel.AbsoluteSize)
            Panel.Position=UDim2.fromOffset(panelCenter.X,panelCenter.Y)
        end)
    end)

    local TitleRow=make("Frame",{BackgroundTransparency=1,Position=UDim2.fromOffset(18,0),Size=UDim2.new(1,-64,1,0),ZIndex=11,Parent=Header})
    make("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,VerticalAlignment=Enum.VerticalAlignment.Center,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,8),Parent=TitleRow})
    local titleWidth=TextService:GetTextSize(Name,22,FONT_BLACK,Vector2.new(400,40)).X+4
    local Title=make("TextLabel",{LayoutOrder=1,BackgroundTransparency=1,Size=UDim2.fromOffset(titleWidth,28),Text=Name,Font=FONT_BLACK,TextSize=22,TextColor3=THEME.Fg,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11,Parent=TitleRow})
    local TagLabel,Badge
    if TagText~="" then
        TagLabel=make("TextLabel",{LayoutOrder=2,BackgroundTransparency=1,AutomaticSize=Enum.AutomaticSize.X,Size=UDim2.new(0,0,0,28),Text=TagText,Font=FONT_BOLD,TextSize=12,TextColor3=THEME.Muted,ZIndex=11,Parent=TitleRow})
    end
    if BadgeText~="" then
        Badge=make("TextLabel",{LayoutOrder=3,AutomaticSize=Enum.AutomaticSize.X,Size=UDim2.new(0,0,0,18),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Text=BadgeText,Font=FONT_BOLD,TextSize=10,TextColor3=THEME.Bg,ZIndex=11,Parent=TitleRow})
        round(Badge,9)
        make("UIPadding",{PaddingLeft=UDim.new(0,7),PaddingRight=UDim.new(0,7),Parent=Badge})
    end

    local CloseBtn=make("TextButton",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-12,0.5,0),Size=UDim2.fromOffset(30,30),BackgroundTransparency=1,AutoButtonColor=false,Text="",ZIndex=11,Parent=Header})
    local closeIcon=buildIcon(CloseBtn,ICONS.close,16,THEME.Muted)
    CloseBtn.MouseButton1Down:Connect(function() setIconColor(closeIcon,THEME.Fg) end)
    CloseBtn.MouseButton1Up:Connect(function() setIconColor(closeIcon,THEME.Muted) end)
    CloseBtn.MouseLeave:Connect(function() setIconColor(closeIcon,THEME.Muted) end)
    CloseBtn.Activated:Connect(function() Window:Close() end)

    local Body=make("Frame",{Name="Body",BackgroundTransparency=1,Position=UDim2.fromOffset(0,HEADER_H),Size=UDim2.new(1,0,1,-HEADER_H),ZIndex=10,Parent=Panel})

    local Sidebar=make("ScrollingFrame",{Name="Tabs",BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(12,4),Size=UDim2.new(0,48,1,-8),CanvasSize=UDim2.new(),ScrollBarThickness=0,ScrollingDirection=Enum.ScrollingDirection.Y,ZIndex=10,Parent=Body})
    local Indicator=make("Frame",{Name="Indicator",Position=UDim2.fromOffset(4,0),Size=UDim2.fromOffset(40,40),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Visible=false,ZIndex=1,Parent=Sidebar})
    round(Indicator,12)

    local Dock=make("Frame",{Name="Dock",BackgroundTransparency=1,AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,12,1,-(4+DOCK_LIFT)),Size=UDim2.fromOffset(48,DOCK_H),Visible=false,ZIndex=10,Parent=Body})
    make("Frame",{Position=UDim2.fromOffset(8,0),Size=UDim2.fromOffset(32,1),BackgroundColor3=THEME.Line,BorderSizePixel=0,Parent=Dock})
    local DockInd=make("Frame",{Name="Indicator",Position=UDim2.fromOffset(4,8),Size=UDim2.fromOffset(40,40),BackgroundColor3=THEME.Accent,BackgroundTransparency=1,BorderSizePixel=0,ZIndex=1,Parent=Dock})
    round(DockInd,12)

    local Content=make("Frame",{Name="Content",BackgroundTransparency=1,Position=UDim2.new(0,72,0,4),Size=UDim2.new(1,-84,1,-10),ZIndex=10,Parent=Body})
    local PageTitle=make("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(10,0),Size=UDim2.new(1,-10,0,22),Text="",Font=FONT_BLACK,TextSize=18,TextColor3=THEME.Fg,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11,Parent=Content})
    local PageSub=make("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(10,23),Size=UDim2.new(1,-10,0,16),Text="",Font=FONT_BOLD,TextSize=12,TextColor3=THEME.Muted,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11,Parent=Content})
    local Pages=make("CanvasGroup",{Name="Pages",BackgroundTransparency=1,Position=UDim2.fromOffset(0,46),Size=UDim2.new(1,0,1,-46),ZIndex=10,Parent=Content})

    local BAR_Y,BAR_H=44,28
    local PAGES_Y,PAGES_Y_BAR=46,80

    local function setTabState(i,selected,instant)
        setIconColor(tabs[i].Icon,selected and THEME.Bg or THEME.Muted,instant)
    end
    local function activeFrame(tab)
        local s=tab.Subs[tab.CurrentSub]
        return s and s.Page or tab.Page
    end
    local function layoutPages(tab)
        local y=(#tab.Subs>0) and PAGES_Y_BAR or PAGES_Y
        Pages.Position=UDim2.fromOffset(0,y)
        Pages.Size=UDim2.new(1,0,1,-y)
    end
    local function scrollBarTo(tab,sub,instant)
        local bar=tab.Bar
        if not bar or not sub then return end
        local view=bar.AbsoluteSize.X/uiScaleFactor()
        local maxX=math.max(0,tab.BarW-view)
        local target=math.clamp(sub.X+sub.W/2-view/2,0,maxX)
        if instant then bar.CanvasPosition=Vector2.new(target,0)
        else tween(bar,0.35,{CanvasPosition=Vector2.new(target,0)}) end
    end
    local function showFrame(tab)
        local active=activeFrame(tab)
        for _,t in ipairs(tabs) do
            t.Page.Visible=(t==tab and #t.Subs==0)
            for _,s in ipairs(t.Subs) do
                s.Page.Visible=(t==tab and s.Page==active)
            end
            if t.Bar then t.Bar.Visible=(t==tab) end
        end
        layoutPages(tab)
        active.CanvasPosition=Vector2.zero
        active.Position=UDim2.fromOffset(26,0)
        Pages.GroupTransparency=1
        tween(active,0.45,{Position=UDim2.fromOffset(0,0)})
        tween(Pages,0.3,{GroupTransparency=0},Enum.EasingStyle.Sine)
    end
    local function showPage(i)
        local tab=tabs[i]
        if not tab then return end
        showFrame(tab)
        typeText(PageTitle,tab.Name,0.03)
        PageSub.Text=tab.Sub
        PageSub.TextTransparency=1
        tween(PageSub,0.4,{TextTransparency=0},Enum.EasingStyle.Sine)
        if tab.Bar then
            tab.BarInd.BackgroundTransparency=1
            tween(tab.BarInd,0.4,{BackgroundTransparency=0},Enum.EasingStyle.Sine)
            for _,s in ipairs(tab.Subs) do
                s.Chip.TextTransparency=1
                tween(s.Chip,0.4,{TextTransparency=0},Enum.EasingStyle.Sine)
            end
            scrollBarTo(tab,tab.Subs[tab.CurrentSub],true)
        end
    end
    local function moveIndicator(tab)
        if tab.Docked then
            tween(DockInd,0.3,{BackgroundTransparency=0},Enum.EasingStyle.Sine)
            tween(Indicator,0.3,{BackgroundTransparency=1},Enum.EasingStyle.Sine)
        else
            local pos=UDim2.fromOffset(4,(tab.Slot-1)*SLOT)
            Indicator.Visible=true
            if Indicator.BackgroundTransparency>0.5 then
                Indicator.Position=pos
                tween(Indicator,0.3,{BackgroundTransparency=0},Enum.EasingStyle.Sine)
            else
                tween(Indicator,0.4,{Position=pos,BackgroundTransparency=0},Enum.EasingStyle.Back)
            end
            tween(DockInd,0.3,{BackgroundTransparency=1},Enum.EasingStyle.Sine)
        end
    end
    local function selectTab(i)
        if i==current or not tabs[i] then return end
        local prev=current
        current=i
        if prev>0 then setTabState(prev,false) end
        setTabState(i,true)
        moveIndicator(tabs[i])
        showPage(i)
    end
    local function selectSub(tab,j)
        local sub=tab.Subs[j]
        if not sub or j==tab.CurrentSub then return end
        local prev=tab.Subs[tab.CurrentSub]
        tab.CurrentSub=j
        if prev then tween(prev.Chip,0.25,{TextColor3=THEME.Muted},Enum.EasingStyle.Sine) end
        tween(sub.Chip,0.25,{TextColor3=THEME.Bg},Enum.EasingStyle.Sine)
        tween(tab.BarInd,0.4,{Position=UDim2.fromOffset(sub.X,0),Size=UDim2.fromOffset(sub.W,BAR_H)})
        scrollBarTo(tab,sub,false)
        if tabs[current]==tab then showFrame(tab) end
    end

    local function newPageFrame(name)
        local page=make("ScrollingFrame",{Name=name,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=2,ScrollBarImageColor3=THEME.Muted,ScrollingDirection=Enum.ScrollingDirection.Y,Visible=false,ZIndex=10,Parent=Pages})
        make("UIListLayout",{Padding=UDim.new(0,0),SortOrder=Enum.SortOrder.LayoutOrder,Parent=page})
        make("UIPadding",{PaddingRight=UDim.new(0,6),PaddingBottom=UDim.new(0,8),Parent=page})
        return page
    end
    local function ensureBar(tab)
        if tab.Bar then return tab.Bar end
        local bar=make("ScrollingFrame",{Name="SubBar",BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromOffset(10,BAR_Y),Size=UDim2.new(1,-16,0,BAR_H),CanvasSize=UDim2.new(),ScrollBarThickness=0,ScrollingDirection=Enum.ScrollingDirection.X,Visible=false,ZIndex=10,Parent=Content})
        local ind=make("Frame",{Name="Indicator",Size=UDim2.fromOffset(40,BAR_H),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Visible=false,ZIndex=1,Parent=bar})
        round(ind,10)
        bar.InputChanged:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseWheel then
                local maxX=math.max(0,tab.BarW-bar.AbsoluteSize.X/uiScaleFactor())
                local nx=math.clamp(bar.CanvasPosition.X-input.Position.Z*40,0,maxX)
                bar.CanvasPosition=Vector2.new(nx,0)
            end
        end)
        tab.Bar,tab.BarInd=bar,ind
        return bar
    end
    local function relayoutSubs(tab)
        local x=0
        for _,s in ipairs(tab.Subs) do
            local w=TextService:GetTextSize(s.Name,13,FONT_BOLD,Vector2.new(400,BAR_H)).X+24
            s.X,s.W=x,w
            s.Chip.Text=s.Name
            s.Chip.Position=UDim2.fromOffset(x,0)
            s.Chip.Size=UDim2.fromOffset(w,BAR_H)
            tab.BarW=x+w
            x=x+w+6
        end
        if tab.Bar then
            tab.Bar.CanvasSize=UDim2.fromOffset(tab.BarW,0)
            local cur=tab.Subs[tab.CurrentSub]
            if cur then
                tab.BarInd.Position=UDim2.fromOffset(cur.X,0)
                tab.BarInd.Size=UDim2.fromOffset(cur.W,BAR_H)
            end
        end
    end

    function Window:AddTab(t)
        t=t or {}
        local i=#tabs+1
        local name=t.Name or ("Sekme "..i)
        local def=resolveIcon(t.Icon)
        if not def then
            if t.Icon~=nil then warn("[AuraMods] Ikon okunamadi ("..name.."), varsayilan ikon kullaniliyor.") end
            def=ICONS.spark
        end
        local docked=t.Dock==true
        local slot=0
        if docked then
            Dock.Visible=true
            Sidebar.Size=UDim2.new(0,48,1,-(4+DOCK_LIFT+DOCK_H+6))
        else
            slots=slots+1
            slot=slots
        end
        local btn=make("TextButton",{Name=name,Position=docked and UDim2.fromOffset(4,8) or UDim2.fromOffset(4,(slot-1)*SLOT),Size=UDim2.fromOffset(40,40),BackgroundTransparency=1,AutoButtonColor=false,Text="",ZIndex=2,Parent=docked and Dock or Sidebar})
        local icon=buildIcon(btn,def,22,THEME.Muted)
        local tab=setmetatable({Name=name,Id=t.Id or name,Docked=docked,Slot=slot,Sub=t.Sub or "",Page=newPageFrame(name),Button=btn,Icon=icon,Window=Window,Subs={},CurrentSub=0,BarW=0,_order=0},Tab)
        tabs[i]=tab
        Sidebar.CanvasSize=UDim2.fromOffset(0,slots*SLOT)
        btn.Activated:Connect(function() selectTab(i) end)
        function tab:SetName(newName)
            tab.Name=tostring(newName)
            btn.Name=tab.Name
            if tabs[current]==tab then
                typeToken[PageTitle]=(typeToken[PageTitle] or 0)+1
                PageTitle.Text=tab.Name
                PageTitle.MaxVisibleGraphemes=-1
            end
        end
        function tab:SetSub(newSub)
            tab.Sub=tostring(newSub)
            if tabs[current]==tab then PageSub.Text=tab.Sub end
        end
        function tab:AddSubPage(st)
            if type(st)=="string" then st={Name=st} end
            st=st or {}
            local bar=ensureBar(tab)
            local j=#tab.Subs+1
            local sname=st.Name or ("Alt "..j)
            local w=TextService:GetTextSize(sname,13,FONT_BOLD,Vector2.new(400,BAR_H)).X+24
            local x=(j==1) and 0 or (tab.BarW+6)
            tab.BarW=x+w
            bar.CanvasSize=UDim2.fromOffset(tab.BarW,0)
            local chip=make("TextButton",{Name=sname,Position=UDim2.fromOffset(x,0),Size=UDim2.fromOffset(w,BAR_H),BackgroundTransparency=1,AutoButtonColor=false,Text=sname,Font=FONT_BOLD,TextSize=13,TextColor3=THEME.Muted,ZIndex=2,Parent=bar})
            local sub=setmetatable({Name=sname,Page=newPageFrame(sname),Chip=chip,X=x,W=w,Parent=tab,Window=Window,_order=0},Tab)
            tab.Subs[j]=sub
            chip.Activated:Connect(function() selectSub(tab,j) end)
            function sub:SetName(newName)
                sub.Name=tostring(newName)
                sub.Page.Name=sub.Name
                chip.Name=sub.Name
                relayoutSubs(tab)
            end
            if j==1 then
                tab.CurrentSub=1
                tab.BarInd.Visible=true
                tab.BarInd.Position=UDim2.fromOffset(x,0)
                tab.BarInd.Size=UDim2.fromOffset(w,BAR_H)
                chip.TextColor3=THEME.Bg
            end
            if isOpen and tabs[current]==tab then showFrame(tab) end
            return sub
        end
        function tab:SelectSub(which)
            local idx=which
            if type(which)=="string" then
                idx=nil
                for k,s in ipairs(tab.Subs) do if s.Name==which then idx=k; break end end
            end
            if idx then selectSub(tab,idx) end
        end
        if i==1 then
            current=1
            if docked then DockInd.BackgroundTransparency=0
            else Indicator.Visible=true; Indicator.Position=UDim2.fromOffset(4,0) end
            setTabState(1,true,true)
            PageTitle.Text=name
            PageSub.Text=tab.Sub
        end
        return tab
    end

    function Window:SelectTab(which)
        local idx=which
        if type(which)=="string" then
            idx=nil
            for i,t in ipairs(tabs) do
                if t.Name==which or t.Id==which then idx=i; break end
            end
        end
        if idx then selectTab(idx) end
    end

    local function playHeader()
        typeText(Title,Name,0.045)
        if TagLabel then TagLabel.TextTransparency=1 end
        if Badge then Badge.TextTransparency=1; Badge.BackgroundTransparency=1 end
        task.delay(0.4,function()
            if not isOpen then return end
            if TagLabel then tween(TagLabel,0.5,{TextTransparency=0},Enum.EasingStyle.Sine) end
            if Badge then tween(Badge,0.5,{TextTransparency=0,BackgroundTransparency=0},Enum.EasingStyle.Sine) end
        end)
    end

    function Window:Open()
        if isOpen then return end
        isOpen=true
        local c=fabCenter()
        local s=panelSize()
        local target=getPanelCenter(s)
        Panel.Size=UDim2.fromOffset(44,44)
        Panel.Position=UDim2.fromOffset(c.X,c.Y)
        Panel.GroupTransparency=1
        Panel.Visible=true
        tween(Fab,0.2,{GroupTransparency=1},Enum.EasingStyle.Sine)
        task.delay(0.2,function() if isOpen then Fab.Visible=false end end)
        tween(Panel,0.55,{Size=UDim2.fromOffset(s.X,s.Y),Position=UDim2.fromOffset(target.X,target.Y),GroupTransparency=0})
        task.delay(0.55,function() if isOpen then panelReady=true end end)
        playHeader()
        showPage(current)
    end

    function Window:Close()
        if not isOpen then return end
        isOpen=false
        panelReady=false
        local c=fabCenter()
        Fab.Visible=true
        Fab.GroupTransparency=1
        tween(Fab,0.35,{GroupTransparency=0},Enum.EasingStyle.Sine)
        local tw=tween(Panel,0.4,{Size=UDim2.fromOffset(44,44),Position=UDim2.fromOffset(c.X,c.Y),GroupTransparency=1},Enum.EasingStyle.Quint,Enum.EasingDirection.InOut)
        tw.Completed:Once(function() if not isOpen then Panel.Visible=false end end)
    end

    function Window:Toggle() if isOpen then Window:Close() else Window:Open() end end
    function Window:IsOpen() return isOpen end
    function Window:ResetPositions()
        Fab.Position=fabStart
        panelCenter=nil
        Window:Close()
    end
    function Window:SetScale()
        local sc=uiScaleFactor()
        fabBase=sc
        fabScale.Scale=sc
        panelScale.Scale=sc
        clampFab()
        applyToastPosition()
        if isOpen then
            local s=panelSize()
            local c=getPanelCenter(s)
            Panel.Size=UDim2.fromOffset(s.X,s.Y)
            Panel.Position=UDim2.fromOffset(c.X,c.Y)
        end
    end
    function Window:Notify(...) return Library:Notify(...) end
    function Window:Destroy() gui:Destroy() end

    Window.Tabs=tabs

    table.insert(conns,gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        clampFab()
        applyToastPosition()
        if isOpen then
            local s=panelSize()
            local c=getPanelCenter(s)
            Panel.Size=UDim2.fromOffset(s.X,s.Y)
            Panel.Position=UDim2.fromOffset(c.X,c.Y)
        end
    end))

    if opts.ToggleKey then
        table.insert(conns,UserInputService.InputBegan:Connect(function(input,processed)
            if not processed and input.KeyCode==opts.ToggleKey then Window:Toggle() end
        end))
    end
    if opts.OpenOnStart then
        task.defer(function() Window:Open() end)
    end
    return Window
end

