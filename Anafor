function Library:Build(config)
    if type(config)=="string" then
        local res,err=decodeJSON(config)
        if not res then
            warn("[AuraMods] JSON okunamadi: "..tostring(err))
            Library:Notify("JSON Hatasi",tostring(err),0,"Error")
            return nil
        end
        config=res
    end
    if type(config)~="table" then
        warn("[AuraMods] Build icin JSON yazisi veya tablo ver.")
        return nil
    end
    for k,v in pairs(config.Settings or {}) do SET[k]=v end
    for k,v in pairs(config.Text or {}) do TXT[k]=v; textOverride[k]=true end
    for k,v in pairs(config.Theme or {}) do
        local c=toColor(v)
        if c and THEME[k]~=nil then THEME[k]=c end
    end
    for k,v in pairs(THEME) do Library.Themes.Default[k]=v end
    Library:SetLanguage(Library.Lang)
    local w=config.Window or {}
    local opts={}
    for k,v in pairs(w) do opts[k]=v end
    if type(w.ToggleKey)=="string" then
        local ok,key=pcall(function() return Enum.KeyCode[w.ToggleKey] end)
        opts.ToggleKey=ok and key or nil
    end
    if type(w.FabPosition)=="table" then opts.FabPosition=UDim2.fromOffset(w.FabPosition[1] or 48,w.FabPosition[2] or 120) end
    if type(w.MinSize)=="table" then opts.MinSize=Vector2.new(w.MinSize[1] or 260,w.MinSize[2] or 270) end
    if type(w.MaxSize)=="table" then opts.MaxSize=Vector2.new(w.MaxSize[1] or 580,w.MaxSize[2] or 340) end
    local Window=Library:CreateWindow(opts)
    Library.Window=Window
    local ctx={Window=Window}
    local function addElements(target,list,where)
        for n,el in ipairs(list or {}) do
            local ok,err=pcall(buildElement,target,el,ctx)
            if not ok then warn("[AuraMods] Eleman kurulamadi ("..where.." #"..n.."): "..tostring(err)) end
        end
    end
    for pi,page in ipairs(config.Pages or {}) do
        local pname=tostring(page.Name or ("Sayfa "..pi))
        local tab=Window:AddTab({Name=page.Name,Sub=page.Sub,Icon=page.Icon})
        if type(page.SubPages)=="table" and #page.SubPages>0 then
            for si,sp in ipairs(page.SubPages) do
                local sub=tab:AddSubPage({Name=sp.Name})
                addElements(sub,sp.Elements,pname.." > "..tostring(sp.Name or si))
            end
        else addElements(tab,page.Elements,pname) end
    end
    buildSettings(Window)
    if w.StartTab~=nil then Window:SelectTab(w.StartTab) end
    if type(config.Startup)=="table" then Library:Notify(config.Startup) end
    local auto=Library:GetAutoConfig()
    if auto and Library:LoadConfig(auto) then
        Library:Notify({Title="Config",Content=L("cfg_autoloaded",{name=auto}),Type="Success"})
    end
    return Window
end

