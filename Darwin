    if BadgeText == nil then BadgeText = "V1 ALPHA" end
    local FabText = opts.FabText or string.sub(Name, 1, 1)
    local fabStart = opts.FabPosition or UDim2.fromOffset(48, 120)
    local minSize = opts.MinSize or Vector2.new(260, 270)
    local maxSize = opts.MaxSize or Vector2.new(580, 340)
    local Window = {}
    local isOpen, current = false, 0
    local panelCenter, panelReady = nil, false
    local tabs = {}
    local slots = 0
    local SLOT, HEADER_H = 40, 46
    local DOCK_H = 50
    local DOCK_LIFT = 12
    local fabBase = uiScaleFactor()
    local Fab = make("CanvasGroup", { Name = "Fab", AnchorPoint = Vector2.new(.5, .5), Position = fabStart, Size = UDim2.fromOffset(44, 44), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Active = true, Parent = gui })
    round(Fab, 14)
    make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = FabText, Font = FONT_BLACK, TextSize = 22, TextColor3 = THEME.Bg, ZIndex = 2, Parent = Fab })
    local fabScale = make("UIScale", { Scale = fabBase, Parent = Fab })
    local function fabCenter() return Vector2.new(Fab.Position.X.Offset, Fab.Position.Y.Offset) end
    local function clampFab()
        local a = gui.AbsoluteSize
        local half = 26 * fabBase
        local c = fabCenter()
        Fab.Position = UDim2.fromOffset(math.clamp(c.X, half, math.max(half, a.X - half)), math.clamp(c.Y, half, math.max(half, a.Y - half)))
    end
    Fab.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        local startPos = Vector2.new(input.Position.X, input.Position.Y)
        local startCenter = fabCenter()
        local moved = false
        tween(fabScale, .12, { Scale = .9 * fabBase })
        beginDrag(input, function(i)
            local delta = Vector2.new(i.Position.X, i.Position.Y) - startPos
            if not moved and delta.Magnitude > 10 then moved = true end
            if moved then
                local a = gui.AbsoluteSize
                local half = 26 * fabBase
                Fab.Position = UDim2.fromOffset(math.clamp(startCenter.X + delta.X, half, math.max(half, a.X - half)), math.clamp(startCenter.Y + delta.Y, half, math.max(half, a.Y - half)))
            end
        end, function()
            tween(fabScale, .3, { Scale = fabBase }, Enum.EasingStyle.Back)
            if not moved then Window:Open() end
        end)
    end)
    local Panel = make("CanvasGroup", { Name = "Panel", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(44, 44), BackgroundColor3 = THEME.Bg, BorderSizePixel = 0, GroupTransparency = 1, Visible = false, Active = true, Parent = gui })
