local function hueToRgb(h)
    h = h % 1
    local r = math.abs(h * 6 - 3) - 1
    local g = 2 - math.abs(h * 6 - 2)
    local b = 2 - math.abs(h * 6 - 4)
    return Color3.new(math.clamp(r,0,1), math.clamp(g,0,1), math.clamp(b,0,1))
end

