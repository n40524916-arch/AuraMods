-- ==================== CONFIG ====================
local CONFIG_PREFIX = "AuraMods_"
local CONFIG_EXT = ".json"
local function getConfigPath(name) return CONFIG_PREFIX .. name .. CONFIG_EXT end
local function listConfigs()
    if type(listfiles) ~= "function" then return {} end
    local ok, files = pcall(listfiles, ".")
    if not ok or not files then return {} end
    local result = {}
    for _, f in ipairs(files) do
        local base = tostring(f):match("([^/\\]+)$") or tostring(f)
        local name = base:match("^" .. CONFIG_PREFIX .. "(.-)" .. CONFIG_EXT .. "$")
        if name and name ~= "" then table.insert(result, name) end
    end
    table.sort(result)
    return result
end
local function saveConfig(name)
    if type(writefile) ~= "function" then return false end
    if not name or name == "" then return false end
    name = name:gsub("[^%w_%-]", "")
    if name == "" then return false end
    local data = {
        ESP = ESP,
        AIM = {enabled=AIM.enabled, fov=AIM.fov, smoothness=AIM.smoothness, teamCheck=AIM.teamCheck, visibleOnly=AIM.visibleOnly, showFov=AIM.showFov, targetPart=AIM.targetPart, prediction=AIM.prediction},
        TRIGGER = TRIGGER,
        PLAYER = {walkSpeed=PLAYER.walkSpeed, jumpPower=PLAYER.jumpPower, tpWalk=PLAYER.tpWalk, tpWalkSpeed=PLAYER.tpWalkSpeed, cameraFov=PLAYER.cameraFov, flySpeed=PLAYER.flySpeed, noclip=PLAYER.noclip, infJump=PLAYER.infJump, touchTP=PLAYER.touchTP, floatSpeed=PLAYER.floatSpeed},
        currentLang=currentLang, currentThemeIndex=currentThemeIndex,
        FULLBRIGHT=FULLBRIGHT, NO_FOG=NO_FOG,
        ANTI_AFK=ANTI_AFK, ANTI_FLING=ANTI_FLING, POTATO=POTATO,
    }
    local ok = pcall(writefile, getConfigPath(name), HttpService:JSONEncode(data))
    return ok
end
local function loadConfig(name)
    if type(readfile) ~= "function" then return false end
    if not name or name == "" then return false end
    local path = getConfigPath(name)
    if type(isfile) == "function" then
        local ok, exists = pcall(isfile, path)
        if not ok or not exists then return false end
    end
    local ok, content = pcall(readfile, path)
    if not ok or not content or content == "" then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or not data then return false end
    if data.ESP then for k, v in pairs(data.ESP) do ESP[k] = v end end
    if data.AIM then for k, v in pairs(data.AIM) do AIM[k] = v end end
    if data.TRIGGER then for k, v in pairs(data.TRIGGER) do TRIGGER[k] = v end end
    if data.PLAYER then
        for k, v in pairs(data.PLAYER) do PLAYER[k] = v end
        local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = PLAYER.walkSpeed h.UseJumpPower = true h.JumpPower = PLAYER.jumpPower end
        if camera then camera.FieldOfView = PLAYER.cameraFov end
    end
    if data.currentLang then currentLang = data.currentLang end
    if data.currentThemeIndex and THEMES[data.currentThemeIndex] then
        currentThemeIndex = data.currentThemeIndex
        currentThemeColor = THEMES[currentThemeIndex].color
    end
    if data.FULLBRIGHT ~= nil then FULLBRIGHT = data.FULLBRIGHT; pcall(function() applyFullbright(FULLBRIGHT) end) end
    if data.NO_FOG ~= nil then NO_FOG = data.NO_FOG; pcall(function() applyNoFog(NO_FOG) end) end
    if data.ANTI_AFK ~= nil then ANTI_AFK = data.ANTI_AFK end
    if data.ANTI_FLING ~= nil then ANTI_FLING = data.ANTI_FLING end
    return true
end

