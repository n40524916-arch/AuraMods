local potatoSaved = { textures = {}, lighting = {}, sky = nil, atmosphere = nil, fx = {} }
local function enablePotato()
    local L = Lighting
    potatoSaved.lighting = {Brightness=L.Brightness, Ambient=L.Ambient, OutdoorAmbient=L.OutdoorAmbient, FogEnd=L.FogEnd, FogStart=L.FogStart, GlobalShadows=L.GlobalShadows}
    for _, v in ipairs(L:GetChildren()) do
        if v:IsA("Sky") then potatoSaved.sky = v; v.Parent = nil
        elseif v:IsA("Atmosphere") then potatoSaved.atmosphere = v; v.Parent = nil
        elseif v:IsA("PostEffect") then if v.Enabled then table.insert(potatoSaved.fx, v); v.Enabled = false end end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            potatoSaved.textures[obj] = obj.Texture
            obj.Texture = ""
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            if obj.Enabled then obj.Enabled = false; table.insert(potatoSaved.fx, obj) end
        end
    end
    pcall(function()
        if workspace.Terrain then
            workspace.Terrain.WaterWaveSize = 0
            workspace.Terrain.WaterWaveSpeed = 0
            workspace.Terrain.WaterReflectance = 0
            workspace.Terrain.WaterTransparency = 1
            workspace.Terrain.Decoration = false
        end
    end)
    L.GlobalShadows = false
    L.FogEnd = 1e9; L.FogStart = 1e9
    L.Brightness = 3
    L.Ambient = Color3.fromRGB(210,210,210)
    L.OutdoorAmbient = Color3.fromRGB(210,210,210)
end
local function disablePotato()
    for obj, tex in pairs(potatoSaved.textures) do pcall(function() obj.Texture = tex end) end
    potatoSaved.textures = {}
    for _, v in ipairs(potatoSaved.fx) do pcall(function() v.Enabled = true end) end
    potatoSaved.fx = {}
    if potatoSaved.sky then pcall(function() potatoSaved.sky.Parent = Lighting end) end
    if potatoSaved.atmosphere then pcall(function() potatoSaved.atmosphere.Parent = Lighting end) end
    potatoSaved.sky = nil; potatoSaved.atmosphere = nil
    local L = potatoSaved.lighting
    if L.Brightness then Lighting.Brightness = L.Brightness end
    if L.Ambient then Lighting.Ambient = L.Ambient end
    if L.OutdoorAmbient then Lighting.OutdoorAmbient = L.OutdoorAmbient end
    if L.FogEnd then Lighting.FogEnd = L.FogEnd end
    if L.FogStart then Lighting.FogStart = L.FogStart end
    if L.GlobalShadows ~= nil then Lighting.GlobalShadows = L.GlobalShadows end
end
function applyFullbright(on)
    if on then
        if not savedLighting then
            savedLighting = {Brightness=Lighting.Brightness, Ambient=Lighting.Ambient, OutdoorAmbient=Lighting.OutdoorAmbient, GlobalShadows=Lighting.GlobalShadows}
        end
        Lighting.Brightness = 3
        Lighting.Ambient = Color3.fromRGB(200,200,200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200)
