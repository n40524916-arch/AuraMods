local function getExecutorName()
    local executors = {"Synapse X","ScriptWare","Krnl","Fluxus","Delta","Hydrogen","Arceus X","Calamari","Codex","Kavo","Sirhurt","WeAreDevs","Oxygen U","Trigona","Sentinel","SirHurt V4","Vega X","Nihon","AWP","Kiwi X","Solara","Xeno","Wave"}
    local ok, execName = pcall(function()
        if type(identifyexecutor) == "function" then return identifyexecutor() end
        if type(getexecutorname) == "function" then return getexecutorname() end
        return nil
    end)
    if ok and execName then
        for _, name in ipairs(executors) do
            if string.find(string.lower(execName), string.lower(name)) then return name end
        end
        return execName
    end
    return "Unknown"
end

