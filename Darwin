local playersTab = Window:AddTab({ Name = "Oyuncular", Sub = "Sunucudaki oyuncular", Icon = "list" })
do
    local function rebuildPlayerList()
        for _, c in ipairs(playersTab.Page:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        playersTab._order = 0
        local function makeRow(plr)
            local row = make("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = THEME.Press, BackgroundTransparency = 0.5, BorderSizePixel = 0, LayoutOrder = (playersTab._order = playersTab._order + 1), Parent = playersTab.Page })
            round(row, 8)
            make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.5, -15, 1, 0), Text = plr.Name, Font = FONT_BOLD, TextSize = 13, TextColor3 = THEME.Fg, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
            local distLabel = make("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.72, 0, 0.5, 0), Size = UDim2.fromOffset(60, 20), BackgroundTransparency = 1, Text = "-", Font = FONT_BOLD, TextSize = 12, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
            task.spawn(function()
                while distLabel.Parent do
                    local myHrp = getHRP()
                    local tHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if myHrp and tHrp then distLabel.Text = math.floor((myHrp.Position - tHrp.Position).Magnitude) .. "m"
                    else distLabel.Text = "-" end
                    task.wait(0.5)
                end
            end)
            local tpBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -100, 0.5, 0), Size = UDim2.fromOffset(44, 26), BackgroundColor3 = THEME.Off, BorderSizePixel = 0, Text = "TP", Font = FONT_BOLD, TextSize = 12, TextColor3 = THEME.Fg, AutoButtonColor = false, Parent = row })
            round(tpBtn, 6)
            tpBtn.Activated:Connect(function()
                local tHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                local myHrp = getHRP()
                if tHrp and myHrp then pcall(function() myHrp.CFrame = tHrp.CFrame + Vector3.new(0, 3, 0) end) end
            end)
            local specBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -52, 0.5, 0), Size = UDim2.fromOffset(44, 26), BackgroundColor3 = (SPECTATE.target == plr and SPECTATE.active) and Color3.fromRGB(0, 180, 80) or THEME.Off, BorderSizePixel = 0, Text = "👁", Font = FONT_BOLD, TextSize = 12, TextColor3 = THEME.Fg, AutoButtonColor = false, Parent = row })
            round(specBtn, 6)
            specBtn.Activated:Connect(function()
                if SPECTATE.target == plr and SPECTATE.active then stopSpectate() else startSpectate(plr) end
                rebuildPlayerList()
            end)
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then makeRow(plr) end
        end
    end
    rebuildPlayerList()
    Players.PlayerAdded:Connect(function() task.wait(0.5) rebuildPlayerList() end)
    Players.PlayerRemoving:Connect(function() task.wait(0.3) rebuildPlayerList() end)
end

