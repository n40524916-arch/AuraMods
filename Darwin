    if not head or not hrp then return nil end
    return {head=head, hrp=hrp, larm=larm, rarm=rarm, lleg=lleg, rleg=rleg, lhand=lhand or larm, rhand=rhand or rarm, lfoot=lfoot or lleg, rfoot=rfoot or rleg}
