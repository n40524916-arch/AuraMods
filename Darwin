function Tab:AddSlider(o)
    o = o or {}
    local tab = self
    local min, max = o.Min or 0, o.Max or 100
    if max < min then min, max = max, min end
    local step = o.Step or o.Increment or 1
    if step <= 0 then step = 1 end
    local decimals = countDecimals(step)
    local suffix = o.Suffix or ""
    local row = newRow(tab, 52)
    rowLabel(row, o.Name or "Slider", 100, 32)
    local valueLabel = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.fromOffset(90, 32), BackgroundTransparency = 1, Text = "", Font = FONT_BOLD, TextSize = 13, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
    local track = make("Frame", { Position = UDim2.new(0, 10, 0, 37), Size = UDim2.new(1, -20, 0, 6), BackgroundColor3 = THEME.Off, BorderSizePixel = 0, Parent = row })
    round(track, 3)
    local fill = make("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Parent = track })
    round(fill, 3)
    local knob = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, ZIndex = 2, Parent = track })
    round(knob, 9)
    local hit = make("TextButton", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = row })
    local function snap(v)
        v = math.clamp(tonumber(v) or min, min, max)
        v = min + math.floor((v - min) / step + .5) * step
        v = math.clamp(v, min, max)
        return tonumber(string.format("%." .. decimals .. "f", v))
    end
    local value = snap(o.Default ~= nil and o.Default or min)
    local dragging, pending = false, false
    local function render(a)
        local p = (max == min) and 0 or (value - min) / (max - min)
        valueLabel.Text = string.format("%." .. decimals .. "f", value) .. suffix
        local fs, kp = UDim2.new(p, 0, 1, 0), UDim2.new(p, 0, .5, 0)
        if a then tween(fill, .15, { Size = fs }, Enum.EasingStyle.Sine) tween(knob, .15, { Position = kp }, Enum.EasingStyle.Sine)
        else fill.Size, knob.Position = fs, kp end
    end
    local function setValue(v, silent, a)
        v = snap(v)
        local changed = v ~= value
        value = v
        render(a)
        if changed then
            setFlag(o.Flag, value)
            if not silent then
                if o.CommitOnRelease and dragging then pending = true else fire(o.Callback, value) end
            end
        end
    end
    hit.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        tab.Page.ScrollingEnabled = false
        dragging = true
        tween(knob, .1, { Size = UDim2.fromOffset(18, 18) })
        beginDrag(input, function(i)
            local p = guiPoint(i)
            local a = math.clamp((p.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            setValue(min + a * (max - min), false, false)
        end, function()
            dragging = false
            tab.Page.ScrollingEnabled = true
            tween(knob, .15, { Size = UDim2.fromOffset(14, 14) })
            if pending then pending = false fire(o.Callback, value) end
        end, true)
    end)
    local api = {}
    function api:Set(v, silent) setValue(v, silent, true) end
    function api:Get() return value end
    render(false)
    setFlag(o.Flag, value)
    return finish(row, api)
end

