local ToastScale = make("UIScale", { Parent = ToastHolder })
local function toastWidth() return math.clamp((gui.AbsoluteSize.X - 32) / uiScaleFactor(), 200, 320) end
local function applyToastPosition()
    local p = TOAST_POS[SET.ToastPosition] or TOAST_POS.TopCenter
    local ax = p[1]
    local margin = (ax == 0 and 14) or (ax == 1 and -14) or 0
    local f = uiScaleFactor()
