local function ring(cx, cy, r, n)
    local t = {}
    for i = 0, n do
        local a = (i / n) * math.pi * 2
        t[#t + 1] = { cx + math.cos(a) * r, cy + math.sin(a) * r }
    end
    return t
end
local function curve(p0, c, p1, n)
    local t = {}
    for i = 0, n do
        local u, v = 1 - i / n, i / n
        t[#t + 1] = { u * u * p0[1] + 2 * u * v * c[1] + v * v * p1[1], u * u * p0[2] + 2 * u * v * c[2] + v * v * p1[2] }
    end
    return t
end
local function concat(a, b)
    local o = {}
    for i = 1, #a do o[#o + 1] = a[i] end
    for i = 2, #b do o[#o + 1] = b[i] end
    return o
end
local function spokes(cx, cy, r0, r1, n)
    local o = {}
    for i = 0, n - 1 do
        local a = (i / n) * math.pi * 2
        o[#o + 1] = { { cx + math.cos(a) * r0, cy + math.sin(a) * r0 }, { cx + math.cos(a) * r1, cy + math.sin(a) * r1 } }
    end
    return o
end
