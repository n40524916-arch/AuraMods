    local row = newRow(self, 40)
    rowLabel(row, o.Name or "Input", width + 20, 40)
    local box = make("TextBox", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(width, 24), BackgroundColor3 = THEME.Off, BorderSizePixel = 0, Text = "", PlaceholderText = o.Placeholder or "", PlaceholderColor3 = THEME.Muted, TextColor3 = THEME.Fg, Font = FONT_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ClearTextOnFocus = o.ClearTextOnFocus == true, Parent = row })
    round(box, 8)
    make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = box })
    local boxStroke = stroke(box, THEME.Off, 1)
    local value
    if numeric then value = tonumber(o.Default) or 0 else value = tostring(o.Default or "") end
    if o.Default ~= nil then box.Text = tostring(value) end
    local api = {}
    local function commit(enter, silent)
        local v = box.Text
        if numeric then
            v = tonumber(box.Text)
            if v == nil then box.Text = o.Default ~= nil and tostring(value) or "" return end
            if o.Min then v = math.max(v, o.Min) end
            if o.Max then v = math.min(v, o.Max) end
            box.Text = tostring(v)
        end
        local changed = v ~= value
        value = v
        setFlag(o.Flag, value)
        if (changed or enter) and not silent then fire(o.Callback, value) end
    end
    box:GetPropertyChangedSignal("Text"):Connect(function()
        local t = box.Text
        if numeric then
            local f = t:gsub("[^%d%.%-]", "")
            if f ~= t then box.Text = f return end
        end
        if o.MaxLength and (utf8.len(t) or #t) > o.MaxLength then
            local cut = (utf8.offset(t, o.MaxLength + 1) or (#t + 1)) - 1
            box.Text = t:sub(1, cut)
            return
        end
        if o.LiveUpdate then
            local v = t
            if numeric then v = tonumber(t) end
            if v ~= nil then value = v setFlag(o.Flag, value) fire(o.Callback, value) end
        end
    end)
    box.Focused:Connect(function() tween(boxStroke, .15, { Color = THEME.Accent }, Enum.EasingStyle.Sine) end)
    box.FocusLost:Connect(function(enter)
        tween(boxStroke, .15, { Color = THEME.Off }, Enum.EasingStyle.Sine)
        commit(enter, false)
    end)
    function api:Set(v, silent) box.Text = tostring(v) commit(false, silent) end
    function api:Get() return value end
    function api:Focus() box:CaptureFocus() end
    function api:SetPlaceholder(t) box.PlaceholderText = tostring(t) end
    setFlag(o.Flag, value)
    return finish(row, api)
end

function Tab:AddDropdown(o)
    o = o or {}
    local H, OPT_H = 40, 28
    local multi = o.Multi == true
    local maxVisible = math.max(1, o.MaxVisible or 5)
    local width = o.Width or 130
    local row = newRow(self, H)
    row.ClipsDescendants = true
    rowLabel(row, o.Name or TXT.Select, width + 20, H)
    local pill = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(width, 24), BackgroundColor3 = THEME.Off, BorderSizePixel = 0, Parent = row })
    round(pill, 8)
    local valueLabel = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -30, 1, 0), Text = "", Font = FONT_BOLD, TextSize = 13, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = pill })
    local chev = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(1, -13, .5, 0), Size = UDim2.fromOffset(14, 14), Rotation = 90, BackgroundTransparency = 1, Parent = pill })
    buildIcon(chev, ICONS.chevron, 14, THEME.Muted)
    local list = make("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(10, H + 2), Size = UDim2.new(1, -20, 0, 0), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollBarImageColor3 = THEME.Muted, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false, Parent = row })
    make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
    local hit = make("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, H), ZIndex = 5, Parent = row })
    local options, buttons, sel = {}, {}, {}
    local open = false
    local function parse(items)
        local out = {}
        for _, item in ipairs(items or {}) do
            if type(item) == "table" then
                local label = item.Label or item.Name or item.Value
                local val = item.Value
                if val == nil then val = label end
                out[#out + 1] = { Label = tostring(label), Value = val }
            else
                out[#out + 1] = { Label = tostring(item), Value = item }
            end
        end
        return out
    end
    local function getValue()
        if multi then
            local out = {}
            for _, opt in ipairs(options) do if sel[opt.Value] then out[#out + 1] = opt.Value end end
            return out
        end
        for _, opt in ipairs(options) do if sel[opt.Value] then return opt.Value end end
        return nil
    end
    local function refreshVisual()
        local labels = {}
        for i, opt in ipairs(options) do
            local on = sel[opt.Value] == true
            local b = buttons[i]
            if b then
                b.Check.Visible = on
                tween(b.Label, .15, { TextColor3 = on and THEME.Fg or THEME.Muted }, Enum.EasingStyle.Sine)
            end
            if on then labels[#labels + 1] = opt.Label end
        end
        if #labels == 0 then
            valueLabel.Text = o.Placeholder or TXT.Select
            valueLabel.TextColor3 = THEME.Muted
        else
            valueLabel.Text = table.concat(labels, ", ")
            valueLabel.TextColor3 = THEME.Fg
        end
    end
    local function changed(silent)
        local v = getValue()
        setFlag(o.Flag, v)
        refreshVisual()
        if not silent then fire(o.Callback, v) end
    end
    local function listHeight() return math.min(#options, maxVisible) * OPT_H end
    local openToken = 0
    local function setOpen(v)
        open = v
        openToken = openToken + 1
        local mine = openToken
        list.Size = UDim2.new(1, -20, 0, listHeight())
        if v then list.Visible = true end
        local tw = tween(row, .3, { Size = UDim2.new(1, 0, 0, H + (v and (listHeight() + 8) or 0)) })
        tween(chev, .25, { Rotation = v and -90 or 90 }, Enum.EasingStyle.Sine)
        if not v then
            tw.Completed:Once(function() if openToken == mine then list.Visible = false end end)
        end
    end
    local function pick(value)
        if multi then sel[value] = (not sel[value]) or nil
        else sel = { [value] = true } end
        changed(false)
        if not multi and o.CloseOnSelect ~= false then setOpen(false) end
    end
    local function build()
        for _, b in ipairs(buttons) do b.Button:Destroy() end
        buttons = {}
        for i, opt in ipairs(options) do
            local btn = make("TextButton", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, OPT_H), BackgroundColor3 = THEME.Press, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, Text = "", Parent = list })
            round(btn, 6)
            local lbl = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -34, 1, 0), Text = opt.Label, Font = FONT_BOLD, TextSize = 13, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn })
            local check = make("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Visible = false, Parent = btn })
            buildIcon(check, ICONS.check, 14, THEME.Accent)
            pressFeedback(btn, btn)
            btn.Activated:Connect(function() pick(opt.Value) end)
            buttons[i] = { Button = btn, Label = lbl, Check = check }
        end
        list.Size = UDim2.new(1, -20, 0, listHeight())
    end
    options = parse(o.Options)
    if multi then
        local d = o.Default
        if type(d) == "table" then for _, x in ipairs(d) do sel[x] = true end
        elseif d ~= nil then sel[d] = true end
    elseif o.Default ~= nil then sel[o.Default] = true end
    build()
    changed(true)
    hit.Activated:Connect(function() setOpen(not open) end)
    local api = {}
    function api:Get() return getValue() end
    function api:Set(v, silent)
        sel = {}
        if multi then
            local arr = type(v) == "table" and v or { v }
            for _, x in ipairs(arr) do sel[x] = true end
        elseif v ~= nil then sel[v] = true end
        changed(silent)
    end
    function api:Refresh(items)
        options = parse(items)
        local valid = {}
        for _, opt in ipairs(options) do if sel[opt.Value] then valid[opt.Value] = true end end
        sel = valid
        build()
        changed(true)
        if open then setOpen(true) end
    end
    function api:Open() setOpen(true) end
    function api:Close() setOpen(false) end
    return finish(row, api)
end

