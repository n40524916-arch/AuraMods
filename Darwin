                myHRP.RotVelocity = Vector3.new(math.random(-500,500), math.random(-500,500), math.random(-500,500))
            end)
            task.wait(0.03)
        end
        task.wait(0.1)
        pcall(function()
            myHRP.Velocity = Vector3.new(0,0,0)
            myHRP.RotVelocity = Vector3.new(0,0,0)
            myHRP.CFrame = originalCFrame
        end)
    end)
end

