local function countDecimals(s)
    local str = string.format("%.6f", s):gsub("0+$", "")
    local d = str:find("%.")
    return d and (#str - d) or 0
end
local function toHex(c) return string.format("#%02X%02X%02X", math.floor(c.R * 255 + .5), math.floor(c.G * 255 + .5), math.floor(c.B * 255 + .5)) end
local function fromHex(s)
    s = tostring(s):gsub("[#%s]", "")
    if #s == 3 then s = s:gsub(".", "%0%0") end
    if #s ~= 6 or s:find("%X") then return nil end
    return Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
end
local function buildIcon(parent, def, size, color)
    local root = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, ZIndex = 3, Parent = parent })
    local parts = {}
    local t = def.stroke or STROKE
    local function node(cx, cy, w, h, rot)
        local f = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(cx / VB, cy / VB), Size = UDim2.fromScale(w / VB, h / VB), Rotation = rot or 0, BackgroundColor3 = color, BorderSizePixel = 0, Parent = root })
        make("UICorner", { CornerRadius = UDim.new(.5, 0), Parent = f })
        parts[#parts + 1] = f
    end
    for _, line in ipairs(def.lines or {}) do
        for i = 1, #line - 1 do
            local a, b = line[i], line[i + 1]
            local dx, dy = b[1] - a[1], b[2] - a[2]
            local len = math.sqrt(dx * dx + dy * dy)
            node((a[1] + b[1]) / 2, (a[2] + b[2]) / 2, len + t, t, math.deg(math.atan2(dy, dx)))
        end
    end
    for _, d in ipairs(def.dots or {}) do node(d[1], d[2], d[3] * 2, d[3] * 2, 0) end
    return { Root = root, Parts = parts }
end
local function setIconColor(icon, color, instant)
    for _, p in ipairs(icon.Parts) do
