end
applyToastPosition()

function Library:Notify(a, b, c, d)
    local o = type(a) == "table" and a or { Title = a, Content = b, Duration = c, Type = d }
    local dir = applyToastPosition()
    local W = toastWidth()
    local title = o.Title ~= nil and tostring(o.Title) or ""
    local content = o.Content ~= nil and tostring(o.Content) or ""
    if title == "" and content == "" then title = TXT.Notice end
    local duration = o.Duration
    if duration == nil then duration = SET.ToastDuration end
    local kind = TOAST_ICON[o.Type] and o.Type or "Info"
    local PADX, PADY, ICON = 14, 12, 18
    local textX = PADX + ICON + 10
    local textW = W - textX - PADX
    local titleH = title ~= "" and 18 or 0
    local contentSize = title ~= "" and 12 or 14
    local contentH = 0
    if content ~= "" then contentH = TextService:GetTextSize(content, contentSize, FONT_BOLD, Vector2.new(textW, 1000)).Y end
    local gap = (titleH > 0 and contentH > 0) and 2 or 0
    local blockH = titleH + gap + contentH
    local H = math.max(PADY * 2 + blockH, 44)
    local top = math.floor((H - blockH) / 2)
    toastSeq = toastSeq + 1
    local wrapper = make("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, LayoutOrder = toastSeq, Parent = ToastHolder })
    local toast = make("CanvasGroup", { Position = UDim2.fromOffset(0, dir * 14), Size = UDim2.new(1, 0, 0, H), BackgroundColor3 = THEME.Fg, BorderSizePixel = 0, GroupTransparency = 1, Parent = wrapper })
    round(toast, 12)
    local iconHolder = make("Frame", { AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, PADX, .5, 0), Size = UDim2.fromOffset(ICON, ICON), BackgroundTransparency = 1, Parent = toast })
    buildIcon(iconHolder, ICONS[TOAST_ICON[kind]], ICON, THEME.Bg)
    if title ~= "" then
        make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(textX, top), Size = UDim2.fromOffset(textW, titleH), Text = title, Font = FONT_BOLD, TextSize = 14, TextColor3 = THEME.Bg, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = toast })
    end
    if content ~= "" then
        make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(textX, top + titleH + gap), Size = UDim2.fromOffset(textW, contentH), Text = content, Font = FONT_BOLD, TextSize = contentSize, TextColor3 = title ~= "" and THEME.ToastMuted or THEME.Bg, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Parent = toast })
    end
    local bar = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = THEME.Muted, BorderSizePixel = 0, Parent = toast })
    local api = {}
    local closed = false
    function api:Close()
        if closed then return end
        closed = true
        for i, t in ipairs(toasts) do if t == api then table.remove(toasts, i) break end end
        tween(toast, .25, { GroupTransparency = 1, Position = UDim2.fromOffset(0, dir * 14) }, Enum.EasingStyle.Sine)
        local tw = tween(wrapper, .3, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
        tw.Completed:Once(function() wrapper:Destroy() end)
        fire(o.OnClose)
    end
    local hit = make("TextButton", { BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = toast })
    hit.Activated:Connect(function() api:Close() end)
    tween(wrapper, .3, { Size = UDim2.new(1, 0, 0, H) })
    tween(toast, .35, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 })
    if type(duration) == "number" and duration > 0 and duration ~= math.huge then
        tween(bar, duration, { Size = UDim2.new(0, 0, 0, 3) }, Enum.EasingStyle.Linear)
        task.delay(duration, function() api:Close() end)
    else
        bar.Visible = false
    end
    toasts[#toasts + 1] = api
    while #toasts > math.max(1, SET.MaxToasts) do toasts[1]:Close() end
    return api
end
function Library:ClearNotifications() for i = #toasts, 1, -1 do toasts[i]:Close() end end
function Library:Destroy() gui:Destroy() end

