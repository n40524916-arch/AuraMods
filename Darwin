local function isVisibleToCamera(plr, hrp)
    if not hrp then return false end
    local origin = camera.CFrame.Position
    local dir = hrp.Position - origin
    local filter = {camera}
    if plr.Character then table.insert(filter, plr.Character) end
    if player.Character then table.insert(filter, player.Character) end
    local params = makeRaycastParams(filter)
    local r = workspace:Raycast(origin, dir, params)
    return r == nil
end

