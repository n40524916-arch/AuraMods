local TOAST_ICON = { Info = "info", Success = "check", Warning = "warn", Error = "close" }
local TOAST_POS = { TopLeft = { 0, "Top" }, TopCenter = { .5, "Top" }, TopRight = { 1, "Top" }, BottomLeft = { 0, "Bottom" }, BottomCenter = { .5, "Bottom" }, BottomRight = { 1, "Bottom" } }
